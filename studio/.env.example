# Studio environment. Copy to `studio/.env` (gitignored).
# Sanity only exposes vars prefixed SANITY_STUDIO_ to the browser bundle.

# Enables film search in the Studio. Use the same read-only TMDB v3 key as the
# site's TMDB_API_KEY. Books use Open Library and need no key.
SANITY_STUDIO_TMDB_API_KEY=
