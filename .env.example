# Spotify "Listening to..." (server-side only; never exposed to the browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# TMDB — auto-fills film poster/director/year at build time (films section).
# Free key from https://www.themoviedb.org/settings/api. Use either the v3 key
# or the v4 read access token. Without it, films keep their own frontmatter.
# (Book covers use Open Library, which needs no key.)
TMDB_API_KEY=
# TMDB_READ_TOKEN=

# Letterboxd import script (scripts/import-letterboxd.ts)
LETTERBOXD_USERNAME=

# Fable import script (scripts/import-fable.ts)
FABLE_USERNAME=

# Privacy-first analytics — set to enable the Plausible script (e.g. www.designedbyalok.com)
PLAUSIBLE_DOMAIN=

# Canonical site URL (informational; astro.config.mjs sets the build value).
# Apex — www.designedbyalok.com 307-redirects here.
SITE_URL=https://designedbyalok.com

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Needed to read drafts. Leave unset for a published-only build.
SANITY_TOKEN=
# Which documents the build sees. Defaults to "published" — set to "drafts" only
# for a preview run (needs SANITY_TOKEN), never in production.
# SANITY_PERSPECTIVE=drafts
