# WriterPro CMS (blog source of truth) — required for fresh blog content at build
# time. If missing or unreachable, the build falls back to src/content/blog.
CMS_API_KEY=
# Override only if the CMS moves
# CMS_API_URL=https://writerpro.vercel.app/api/cms/posts

# Spotify "Listening to..." (server-side only; never exposed to the browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Letterboxd import script (scripts/import-letterboxd.ts)
LETTERBOXD_USERNAME=

# Fable import script (scripts/import-fable.ts)
FABLE_USERNAME=

# Privacy-first analytics — set to enable the Plausible script (e.g. www.designedbyalok.com)
PLAUSIBLE_DOMAIN=

# Canonical site URL (informational; astro.config.mjs sets the build value)
SITE_URL=https://www.designedbyalok.com
