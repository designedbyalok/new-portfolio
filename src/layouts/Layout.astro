---
// Site fonts: IBM Plex Sans (body) + Averia Serif Libre bold-italic (display)
// Used in both light and dark themes.
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/averia-serif-libre/latin-700-italic.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ibmPlexSansWoff2 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import averiaItalicWoff2 from "@fontsource/averia-serif-libre/files/averia-serif-libre-latin-700-italic.woff2?url";

interface Props {
  title?: string;
  headline?: string;
  description?: string;
  bodyClass?: string;
  image?: string;
  article?: boolean;
  publishDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks (e.g. Book/Movie Review rich results) */
  schemas?: Record<string, unknown>[];
}

const {
  title = "Alok Kumar — Product Designer",
  headline,
  description = "Product Designer. Simplifying digital healthcare for all end-users.",
  bodyClass = "",
  image = "/og.png",
  article = false,
  publishDate,
  modifiedDate,
  noindex = false,
  schemas = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const plausibleDomain = import.meta.env.PLAUSIBLE_DOMAIN;

const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: headline ?? title,
      description: description,
      image: socialImageURL.toString(),
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.toString() },
      author: {
        "@type": "Person",
        name: "Alok Kumar",
        url: "https://designedbyalok.com",
      },
      publisher: {
        "@type": "Person",
        name: "Alok Kumar",
        url: "https://designedbyalok.com",
      },
      ...(publishDate && { datePublished: publishDate }),
      ...(modifiedDate && { dateModified: modifiedDate }),
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Alok Kumar",
      url: "https://designedbyalok.com",
      jobTitle: "Product Designer",
      description: description,
      image: socialImageURL.toString(),
      sameAs: [
        "https://x.com/designedbyalok",
        "https://www.linkedin.com/in/designedbyalok/",
        "https://github.com/designedbyalok",
        "https://dribbble.com/designedbyalok",
      ],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F5F0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />

    <link rel="preload" as="font" type="font/woff2" href={ibmPlexSansWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={averiaItalicWoff2} crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alok Kumar" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Alok Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={socialImageURL} />
    {article && publishDate && (
      <meta property="article:published_time" content={publishDate} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@designedbyalok" />
    <meta name="twitter:creator" content="@designedbyalok" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Alok Kumar — Blog"
      href={new URL("rss.xml", Astro.site)}
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {plausibleDomain && (
      <script
        defer
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}

    <ClientRouter />

    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var saved = localStorage.getItem("theme");
            var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            if (saved === "light" || saved === "dark") {
              document.documentElement.setAttribute("data-theme", saved);
            } else {
              document.documentElement.setAttribute("data-theme", prefersDark ? "dark" : "light");
            }
          } catch (e) {
            /* ignore */
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
