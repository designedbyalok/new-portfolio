---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import BookCover from "../../components/BookCover.astro";
import { getBooks, type Book } from "../../lib/books";
import { marked } from "marked";

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

type Props = { book: Book };
const { book } = Astro.props;
const b = book.metadata;

const toDate = (iso?: string) => (iso ? new Date(iso) : undefined);
const startedAt = toDate(b.startedAt);
const finishedAt = toDate(b.finishedAt);

const fmtMonth = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const statusLabel: Record<string, string> = {
  "currently-reading": "Currently reading",
  finished: "Finished",
  paused: "Paused",
  abandoned: "Abandoned",
  wishlist: "On the wishlist",
};

const whenRead = (() => {
  if (b.status === "finished" && finishedAt) return `Finished ${fmtMonth(finishedAt)}`;
  if (b.status === "currently-reading" && startedAt)
    return `Reading since ${fmtMonth(startedAt)}`;
  if (startedAt && finishedAt) return `${fmtMonth(startedAt)} – ${fmtMonth(finishedAt)}`;
  if (startedAt) return `Started ${fmtMonth(startedAt)}`;
  return statusLabel[b.status];
})();

const rating = b.rating ? Math.round(b.rating) : 0;
const htmlNotes = book.markdownContent ? marked.parse(book.markdownContent) : "";

// Book + Review rich-results schema (star snippets in search)
const bookEntity = {
  "@type": "Book",
  name: book.title,
  author: { "@type": "Person", name: b.author },
  ...(b.cover && { image: b.cover }),
};
const bookSchema =
  b.rating || b.review
    ? {
        "@context": "https://schema.org",
        "@type": "Review",
        itemReviewed: bookEntity,
        author: {
          "@type": "Person",
          name: "Alok Kumar",
          url: "https://designedbyalok.com",
        },
        ...(b.rating && {
          reviewRating: {
            "@type": "Rating",
            ratingValue: b.rating,
            bestRating: 5,
          },
        }),
        ...(b.review && { reviewBody: b.review }),
      }
    : { "@context": "https://schema.org", ...bookEntity };
---

<Layout
  title={`${book.title} — Reading — Alok Kumar`}
  headline={book.title}
  description={b.review ?? `${book.title} by ${b.author} — ${statusLabel[b.status]}.`}
  article={true}
  image={`/og/books/${book.slug}.png`}
  schemas={[bookSchema]}
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/books" aria-label="Back to reading">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <article class="book-page animate a2">
      <div class="book-page-top">
        <div class="book-page-cover">
          <BookCover
            title={book.title}
            author={b.author}
            spineColor={b.spineColor ?? "#333333"}
            textColor={b.textColor ?? "#ffffff"}
            cover={b.cover}
          />
        </div>

        <header class="book-page-head">
          <p class="eyebrow">{statusLabel[b.status]}</p>
          <h1 class="book-page-title">{book.title}</h1>
          <p class="book-page-author">{b.author}</p>

          <div class="book-page-meta">
            {rating > 0 && (
              <span class="stars" aria-label={`Rated ${rating} of 5`}>
                <span class="stars-filled" aria-hidden="true">{"★".repeat(rating)}</span><span class="stars-empty" aria-hidden="true">{"☆".repeat(5 - rating)}</span>
              </span>
            )}
            <span class="book-page-when">{whenRead}</span>
          </div>
        </header>
      </div>

      <div class="book-page-content">
        {b.review && <p class="book-page-review">{b.review}</p>}

        {b.favoriteQuote && (
          <blockquote class="book-page-quote">{b.favoriteQuote}</blockquote>
        )}

        {b.whyItMatters && (
          <div class="book-page-field">
            <p class="eyebrow">Why it matters</p>
            <p>{b.whyItMatters}</p>
          </div>
        )}

        {htmlNotes && (
          <div class="prose book-page-notes" set:html={htmlNotes}></div>
        )}
      </div>
    </article>
  </div>
</Layout>

<style>
  .book-page {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vw, 48px);
  }
  /* Top row: cover + title/author/meta beside it. */
  .book-page-top {
    display: grid;
    grid-template-columns: minmax(150px, 190px) 1fr;
    gap: clamp(24px, 5vw, 44px);
    align-items: center;
  }
  .book-page-head {
    min-width: 0;
  }
  @media (max-width: 640px) {
    .book-page-top {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    .book-page-cover {
      max-width: 180px;
    }
  }
  /* Everything below spans the full content width. */
  .book-page-content {
    width: 100%;
  }
  .book-page-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.4rem;
    color: var(--fg);
  }
  .book-page-author {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--fg-secondary);
  }
  .book-page-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 16px;
  }
  .stars {
    font-size: var(--text-base);
    letter-spacing: 2px;
    line-height: 1;
  }
  .stars-filled { color: var(--fg); }
  .stars-empty { color: var(--fg-tertiary); }
  .book-page-when {
    font-size: var(--text-sm);
    color: var(--fg-tertiary);
  }
  .book-page-content > :first-child {
    margin-top: 0;
  }
  .book-page-review {
    margin: 0 0 1.75rem;
    font-size: var(--text-lg);
    color: var(--fg);
    line-height: 1.7;
  }
  .book-page-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--fg);
    border-left: 3px solid var(--fg);
    padding-left: 1.2em;
    margin: 0 0 2rem;
    line-height: 1.5;
  }
  .book-page-field {
    margin-top: 1.75rem;
  }
  .book-page-field .eyebrow {
    margin: 0 0 6px;
  }
  .book-page-field p:last-child {
    margin: 0;
    color: var(--fg-secondary);
    line-height: 1.7;
  }
  .book-page-notes {
    margin-top: 1.75rem;
  }
  .book-page-notes:empty {
    display: none;
  }
</style>
