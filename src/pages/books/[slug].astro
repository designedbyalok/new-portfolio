---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import BookCover from "../../components/BookCover.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const books = await getCollection("books");
  return books.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"books"> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const b = entry.data;

const fmtMonth = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const statusLabel: Record<string, string> = {
  "currently-reading": "Currently reading",
  finished: "Finished",
  paused: "Paused",
  abandoned: "Abandoned",
  wishlist: "On the wishlist",
};

const whenRead = (() => {
  if (b.status === "finished" && b.finishedAt) return `Finished ${fmtMonth(b.finishedAt)}`;
  if (b.status === "currently-reading" && b.startedAt) return `Reading since ${fmtMonth(b.startedAt)}`;
  if (b.startedAt && b.finishedAt) return `${fmtMonth(b.startedAt)} – ${fmtMonth(b.finishedAt)}`;
  if (b.startedAt) return `Started ${fmtMonth(b.startedAt)}`;
  return statusLabel[b.status];
})();

const rating = b.rating ? Math.round(b.rating) : 0;
---

<Layout
  title={`${b.title} — Reading — Alok Kumar`}
  headline={b.title}
  description={b.review ?? `${b.title} by ${b.author} — ${statusLabel[b.status]}.`}
  article={true}
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/books" aria-label="Back to reading">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <article class="book-page animate a2">
      <div class="book-page-cover">
        <BookCover
          title={b.title}
          author={b.author}
          spineColor={b.spineColor}
          textColor={b.textColor}
          cover={b.cover}
        />
      </div>

      <div class="book-page-body">
        <p class="eyebrow">{statusLabel[b.status]}</p>
        <h1 class="book-page-title">{b.title}</h1>
        <p class="book-page-author">{b.author}</p>

        <div class="book-page-meta">
          {rating > 0 && (
            <span class="stars" aria-label={`Rated ${rating} of 5`}>
              <span class="stars-filled" aria-hidden="true">{"★".repeat(rating)}</span><span class="stars-empty" aria-hidden="true">{"☆".repeat(5 - rating)}</span>
            </span>
          )}
          <span class="book-page-when">{whenRead}</span>
        </div>

        {b.review && <p class="book-page-review">{b.review}</p>}

        {b.favoriteQuote && (
          <blockquote class="book-page-quote">{b.favoriteQuote}</blockquote>
        )}

        {b.whyItMatters && (
          <div class="book-page-field">
            <p class="eyebrow">Why it matters</p>
            <p>{b.whyItMatters}</p>
          </div>
        )}

        <div class="prose book-page-notes">
          <Content />
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .book-page {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(160px, 240px) 1fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: start;
  }
  @media (max-width: 640px) {
    .book-page {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .book-page-cover {
      max-width: 200px;
    }
  }
  .book-page-cover {
    position: sticky;
    top: 32px;
  }
  .book-page-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.4rem;
    color: var(--fg);
  }
  .book-page-author {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--fg-secondary);
  }
  .book-page-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 16px;
  }
  .stars {
    font-size: var(--text-base);
    letter-spacing: 2px;
    line-height: 1;
  }
  .stars-filled { color: var(--fg); }
  .stars-empty { color: var(--fg-tertiary); }
  .book-page-when {
    font-size: var(--text-sm);
    color: var(--fg-tertiary);
  }
  .book-page-review {
    margin: 24px 0 0;
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--fg);
    line-height: 1.7;
  }
  .book-page-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--fg);
    border-left: 3px solid var(--fg);
    padding-left: 1.2em;
    margin: 2rem 0;
    line-height: 1.5;
    max-width: 60ch;
  }
  .book-page-field {
    margin-top: 1.75rem;
    max-width: 60ch;
  }
  .book-page-field .eyebrow {
    margin: 0 0 6px;
  }
  .book-page-field p:last-child {
    margin: 0;
    color: var(--fg-secondary);
    line-height: 1.7;
  }
  .book-page-notes {
    margin-top: 1.75rem;
  }
  .book-page-notes:empty {
    display: none;
  }
</style>
