---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import { getCollection } from "astro:content";

const books = await getCollection("books");

type Book = (typeof books)[number];

const fmtMonth = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", year: "numeric" });

const statusLine = (b: Book) => {
  const { status, startedAt, finishedAt } = b.data;
  switch (status) {
    case "finished":
      return finishedAt ? `Finished · ${fmtMonth(finishedAt)}` : "Finished";
    case "currently-reading":
      return startedAt
        ? `Currently reading · started ${fmtMonth(startedAt)}`
        : "Currently reading";
    case "paused":
      return startedAt ? `Paused · started ${fmtMonth(startedAt)}` : "Paused";
    case "abandoned":
      return "Abandoned";
    default:
      return "Wishlist";
  }
};

const timelineMeta = (b: Book) => {
  switch (b.data.status) {
    case "finished":
      return b.data.finishedAt
        ? String(b.data.finishedAt.getFullYear())
        : "Finished";
    case "currently-reading":
      return "Reading";
    case "paused":
      return "Paused";
    case "abandoned":
      return "Abandoned";
    default:
      return "Wishlist";
  }
};

/* ---- Shelf: every non-wishlist book; currently-reading last (leaning) ---- */
const finishedAtMs = (b: Book) => b.data.finishedAt?.getTime() ?? 0;
const startedAtMs = (b: Book) => b.data.startedAt?.getTime() ?? 0;

const reading = books
  .filter((b) => b.data.status === "currently-reading")
  .sort((a, b) => startedAtMs(a) - startedAtMs(b));

const shelfRest = books
  .filter(
    (b) => b.data.status !== "wishlist" && b.data.status !== "currently-reading",
  )
  .sort((a, b) => finishedAtMs(b) - finishedAtMs(a));

const shelf = [...shelfRest, ...reading];

/* ---- Timeline groups ---- */
const byTitle = (a: Book, b: Book) => a.data.title.localeCompare(b.data.title);

const finished = books.filter((b) => b.data.status === "finished");
const finishedDated = finished
  .filter((b) => b.data.finishedAt)
  .sort((a, b) => finishedAtMs(b) - finishedAtMs(a));
const finishedUndated = finished
  .filter((b) => !b.data.finishedAt)
  .sort(byTitle);
const years = [
  ...new Set(finishedDated.map((b) => b.data.finishedAt!.getFullYear())),
].sort((a, b) => b - a);

const groups: { label: string; items: Book[] }[] = [];
if (reading.length > 0) {
  groups.push({
    label: "Currently reading",
    items: [...reading].sort((a, b) => startedAtMs(b) - startedAtMs(a)),
  });
}
for (const year of years) {
  groups.push({
    label: `Finished ${year}`,
    items: finishedDated.filter(
      (b) => b.data.finishedAt!.getFullYear() === year,
    ),
  });
}
if (finishedUndated.length > 0) {
  groups.push({ label: "Finished", items: finishedUndated });
}
for (const [label, status] of [
  ["Paused", "paused"],
  ["Abandoned", "abandoned"],
  ["Wishlist", "wishlist"],
] as const) {
  const items = books.filter((b) => b.data.status === status).sort(byTitle);
  if (items.length > 0) groups.push({ label, items });
}

/* ---- Static per-book data for the detail panel (no client fetch) ---- */
const detailData = Object.fromEntries(
  books.map((b) => [
    b.id,
    {
      title: b.data.title,
      author: b.data.author,
      rating: b.data.rating ?? null,
      statusLine: statusLine(b),
      review: b.data.review ?? null,
      favoriteQuote: b.data.favoriteQuote ?? null,
      whyItMatters: b.data.whyItMatters ?? null,
    },
  ]),
);
const detailJson = JSON.stringify(detailData).replace(/</g, "\\u003c");
---

<Layout
  title="Reading — Alok Kumar"
  description="Bookshelf and reading timeline — what I'm reading and what stuck."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 3rem;">
      <h1 class="page-heading animate a2">reading</h1>
    </div>

    <section class="shelf-section animate a3">
      <div class="shelf">
        {
          shelf.map((book) => (
            <button
              type="button"
              class:list={[
                "spine",
                book.data.status === "currently-reading" && "spine-leaning",
              ]}
              style={`background-color: ${book.data.spineColor}; color: ${book.data.textColor};`}
              data-book-spine
              data-book-id={book.id}
              aria-label={`${book.data.title} by ${book.data.author}`}
              aria-expanded="false"
              aria-controls="book-detail"
            >
              <span class="spine-title">{book.data.title}</span>
            </button>
          ))
        }
      </div>

      <div class="book-detail" id="book-detail" hidden>
        <button class="detail-close" type="button" aria-label="Close" data-detail-close>✕</button>
        <p class="detail-title" data-detail-title></p>
        <p class="detail-author" data-detail-author></p>
        <p class="detail-stars-row" data-detail-rating hidden>
          <span class="stars" data-detail-stars>
            <span class="stars-filled" aria-hidden="true"></span><span class="stars-empty" aria-hidden="true"></span>
          </span>
        </p>
        <p class="detail-status" data-detail-status></p>
        <p class="detail-review" data-detail-review hidden></p>
        <blockquote class="detail-quote" data-detail-quote hidden></blockquote>
        <div class="detail-why" data-detail-why hidden>
          <p class="eyebrow">Why it matters</p>
          <p class="detail-why-text" data-detail-why-text></p>
        </div>
      </div>
    </section>

    <section class="timeline animate a4">
      <p class="eyebrow timeline-label">Timeline</p>
      {
        groups.map((group, gi) => (
          <div class={`timeline-group animate a${Math.min(gi + 5, 10)}`}>
            <p class="eyebrow timeline-group-label">{group.label}</p>
            <div class="blur-list book-list">
              {group.items.map((book) => (
                <button
                  type="button"
                  class="blur-item book-row"
                  data-book-row
                  data-book-id={book.id}
                  aria-controls="book-detail"
                >
                  <span class="blur-item-left">
                    <span class="blur-item-title">{book.data.title}</span>
                    <span class="book-author">{book.data.author}</span>
                  </span>
                  <span class="blur-item-meta">{timelineMeta(book)}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <script type="application/json" id="books-data" set:html={detailJson} />
  </div>
</Layout>

<style>
  /* ---- Shelf ---- */
  .shelf-section {
    width: 100%;
    margin-bottom: 3.5rem;
  }
  .shelf {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
    border-bottom: 2px solid var(--border);
    padding-bottom: 0;
  }
  .spine {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 180px;
    padding: 12px 0;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    /* Subtle inset highlight over the frontmatter spineColor */
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.04) 14%,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.18) 100%
    );
    transition: transform 0.2s ease;
  }
  .spine:nth-child(3n) {
    height: 188px;
  }
  .spine:nth-child(4n) {
    height: 168px;
  }
  .spine:hover,
  .spine:focus-visible {
    transform: translateY(-4px);
  }
  .spine:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .spine-title {
    writing-mode: vertical-rl;
    font-size: var(--text-xs);
    font-weight: 500;
    color: inherit;
    max-height: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Currently-reading spines lean against the rest */
  .spine-leaning {
    transform: rotate(4deg) translateY(-3px);
    transform-origin: bottom left;
    margin-left: 10px;
    margin-right: 8px;
  }
  .spine-leaning:hover,
  .spine-leaning:focus-visible {
    transform: rotate(4deg) translateY(-7px);
  }

  /* ---- Detail panel ---- */
  .book-detail {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    margin-top: 20px;
  }
  .detail-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    line-height: 1;
    transition: background 0.2s ease;
  }
  .detail-close:hover,
  .detail-close:focus-visible {
    background: var(--hover-bg);
    color: var(--fg);
  }
  .detail-title {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--fg);
    padding-right: 40px;
  }
  .detail-author {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .detail-stars-row {
    margin: 10px 0 0;
  }
  .stars {
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: 2px;
  }
  .stars-filled {
    color: var(--fg);
  }
  .stars-empty {
    color: var(--fg-tertiary);
  }
  .detail-status {
    margin: 8px 0 0;
    font-size: var(--text-xs);
    color: var(--fg-tertiary);
  }
  .detail-review {
    margin: 16px 0 0;
    max-width: 65ch;
    font-size: var(--text-base);
    color: var(--fg-secondary);
    line-height: 1.7;
  }
  .detail-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--fg);
    border-left: 3px solid var(--fg);
    padding-left: 1.2em;
    margin: 1.25em 0;
    line-height: 1.6;
    max-width: 65ch;
  }
  .detail-why {
    margin-top: 18px;
  }
  .detail-why .eyebrow {
    margin: 0 0 4px;
  }
  .detail-why-text {
    margin: 0;
    max-width: 65ch;
    font-size: var(--text-sm);
    color: var(--fg-secondary);
    line-height: 1.7;
  }

  /* ---- Timeline ---- */
  .timeline {
    width: 100%;
  }
  .timeline-label {
    margin: 0 0 20px;
  }
  .timeline-group {
    width: 100%;
    margin-bottom: 2.5rem;
  }
  .timeline-group-label {
    margin: 0 0 12px;
  }

  /* Button reset so .blur-item styles apply cleanly */
  button.book-row {
    width: 100%;
    background: none;
    font: inherit;
    color: var(--fg);
    text-align: left;
    border-left: none;
    border-right: none;
    border-top: none;
    cursor: pointer;
  }
  .book-list button.book-row:first-child {
    border-top: 1px solid var(--border);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .book-row .blur-item-left {
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    min-width: 0;
  }
  .book-author {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .book-row .blur-item-meta {
    flex-shrink: 0;
    margin-left: 16px;
  }
</style>

<script>
  function initBookshelf() {
    const dataEl = document.getElementById("books-data");
    const panel = document.getElementById("book-detail");
    if (!dataEl || !panel) return;
    if (panel.dataset.bound === "true") return;
    panel.dataset.bound = "true";

    type BookDetail = {
      title: string;
      author: string;
      rating: number | null;
      statusLine: string;
      review: string | null;
      favoriteQuote: string | null;
      whyItMatters: string | null;
    };
    let booksById: Record<string, BookDetail> = {};
    try {
      booksById = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }

    const q = <T extends HTMLElement>(sel: string) =>
      panel.querySelector<T>(sel);
    const titleEl = q("[data-detail-title]");
    const authorEl = q("[data-detail-author]");
    const ratingRow = q("[data-detail-rating]");
    const starsEl = q("[data-detail-stars]");
    const starsFilled = q(".stars-filled");
    const starsEmpty = q(".stars-empty");
    const statusEl = q("[data-detail-status]");
    const reviewEl = q("[data-detail-review]");
    const quoteEl = q<HTMLQuoteElement>("[data-detail-quote]");
    const whyWrap = q("[data-detail-why]");
    const whyText = q("[data-detail-why-text]");

    const spines = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-book-spine]"),
    );

    const setActiveSpine = (id: string | null) => {
      spines.forEach((s) => {
        s.setAttribute(
          "aria-expanded",
          s.dataset.bookId === id ? "true" : "false",
        );
      });
    };

    let activeId: string | null = null;

    const openBook = (id: string, scrollToPanel: boolean) => {
      const book = booksById[id];
      if (!book) return;

      if (titleEl) titleEl.textContent = book.title;
      if (authorEl) authorEl.textContent = book.author;

      if (book.rating && ratingRow && starsEl && starsFilled && starsEmpty) {
        const n = Math.round(book.rating);
        starsFilled.textContent = "★".repeat(n);
        starsEmpty.textContent = "☆".repeat(Math.max(0, 5 - n));
        starsEl.setAttribute("aria-label", `Rated ${n} of 5`);
        ratingRow.hidden = false;
      } else if (ratingRow) {
        ratingRow.hidden = true;
      }

      if (statusEl) statusEl.textContent = book.statusLine;

      if (reviewEl) {
        reviewEl.textContent = book.review || "";
        reviewEl.hidden = !book.review;
      }
      if (quoteEl) {
        quoteEl.textContent = book.favoriteQuote || "";
        quoteEl.hidden = !book.favoriteQuote;
      }
      if (whyWrap && whyText) {
        whyText.textContent = book.whyItMatters || "";
        whyWrap.hidden = !book.whyItMatters;
      }

      panel.hidden = false;
      activeId = id;
      setActiveSpine(id);

      if (scrollToPanel) {
        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        panel.scrollIntoView({
          block: "nearest",
          behavior: reduced ? "auto" : "smooth",
        });
      }
    };

    const closeBook = () => {
      panel.hidden = true;
      activeId = null;
      setActiveSpine(null);
    };

    spines.forEach((spine) => {
      if (spine.dataset.bound === "true") return;
      spine.dataset.bound = "true";
      spine.addEventListener("click", () => {
        const id = spine.dataset.bookId;
        if (!id) return;
        if (!panel.hidden && activeId === id) {
          closeBook();
        } else {
          openBook(id, false);
        }
      });
    });

    document
      .querySelectorAll<HTMLButtonElement>("[data-book-row]")
      .forEach((row) => {
        if (row.dataset.bound === "true") return;
        row.dataset.bound = "true";
        row.addEventListener("click", () => {
          const id = row.dataset.bookId;
          if (id) openBook(id, true);
        });
      });

    const closeBtn = panel.querySelector<HTMLButtonElement>(
      "[data-detail-close]",
    );
    if (closeBtn && closeBtn.dataset.bound !== "true") {
      closeBtn.dataset.bound = "true";
      closeBtn.addEventListener("click", closeBook);
    }
  }

  initBookshelf();
  document.addEventListener("astro:after-swap", initBookshelf);
</script>
