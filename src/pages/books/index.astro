---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import BookCover from "../../components/BookCover.astro";
import { getBooks, type Book } from "../../lib/books";

const books = await getBooks();

const toDate = (iso?: string) => (iso ? new Date(iso) : undefined);

const fmtMonth = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", year: "numeric" });

const statusLine = (b: Book) => {
  const { status, startedAt, finishedAt } = b.metadata;
  const started = toDate(startedAt);
  const finished = toDate(finishedAt);
  switch (status) {
    case "finished":
      return finished ? `Finished · ${fmtMonth(finished)}` : "Finished";
    case "currently-reading":
      return started
        ? `Currently reading · started ${fmtMonth(started)}`
        : "Currently reading";
    case "paused":
      return started ? `Paused · started ${fmtMonth(started)}` : "Paused";
    case "abandoned":
      return "Abandoned";
    default:
      return "Wishlist";
  }
};

const timelineMeta = (b: Book) => {
  const finished = toDate(b.metadata.finishedAt);
  switch (b.metadata.status) {
    case "finished":
      return finished ? String(finished.getFullYear()) : "Finished";
    case "currently-reading":
      return "Reading";
    case "paused":
      return "Paused";
    case "abandoned":
      return "Abandoned";
    default:
      return "Wishlist";
  }
};

const finishedAtMs = (b: Book) => toDate(b.metadata.finishedAt)?.getTime() ?? 0;
const startedAtMs = (b: Book) => toDate(b.metadata.startedAt)?.getTime() ?? 0;

const reading = books
  .filter((b) => b.metadata.status === "currently-reading")
  .sort((a, b) => startedAtMs(a) - startedAtMs(b));

const shelfRest = books
  .filter(
    (b) =>
      b.metadata.status !== "wishlist" &&
      b.metadata.status !== "currently-reading",
  )
  .sort((a, b) => finishedAtMs(b) - finishedAtMs(a));

const shelf = [...shelfRest, ...reading];

const byTitle = (a: Book, b: Book) => a.title.localeCompare(b.title);

const finished = books.filter((b) => b.metadata.status === "finished");
const finishedDated = finished
  .filter((b) => b.metadata.finishedAt)
  .sort((a, b) => finishedAtMs(b) - finishedAtMs(a));
const finishedUndated = finished
  .filter((b) => !b.metadata.finishedAt)
  .sort(byTitle);
const years = [
  ...new Set(
    finishedDated.map((b) => toDate(b.metadata.finishedAt)!.getFullYear()),
  ),
].sort((a, b) => b - a);

const groups: { label: string; items: Book[] }[] = [];
if (reading.length > 0) {
  groups.push({
    label: "Currently reading",
    items: [...reading].sort((a, b) => startedAtMs(b) - startedAtMs(a)),
  });
}
for (const year of years) {
  groups.push({
    label: `Finished ${year}`,
    items: finishedDated.filter(
      (b) => toDate(b.metadata.finishedAt)!.getFullYear() === year,
    ),
  });
}
if (finishedUndated.length > 0) {
  groups.push({ label: "Finished", items: finishedUndated });
}
for (const [label, status] of [
  ["Paused", "paused"],
  ["Abandoned", "abandoned"],
  ["Wishlist", "wishlist"],
] as const) {
  const items = books
    .filter((b) => b.metadata.status === status)
    .sort(byTitle);
  if (items.length > 0) groups.push({ label, items });
}

const ratingOf = (b: Book) =>
  b.metadata.rating ? Math.round(b.metadata.rating) : 0;
---

<Layout
  title="Reading — Alok Kumar"
  description="Bookshelf and reading timeline — what I'm reading and what stuck."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 3rem;">
      <h1 class="page-heading animate a2">reading</h1>
    </div>

    <section class="shelf-section animate a3">
      <div class="shelf">
        {
          shelf.map((book) => (
            <button
              type="button"
              class:list={[
                "spine",
                book.metadata.status === "currently-reading" && "spine-leaning",
              ]}
              style={`background-color: ${book.metadata.spineColor ?? "#333333"}; color: ${book.metadata.textColor ?? "#ffffff"};`}
              data-book-spine
              data-book-id={book.slug}
              aria-label={`Open ${book.title} by ${book.metadata.author}`}
              aria-haspopup="dialog"
            >
              <span class="spine-title">{book.title}</span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="timeline animate a4">
      <p class="eyebrow timeline-label">Timeline</p>
      {
        groups.map((group, gi) => (
          <div class={`timeline-group animate a${Math.min(gi + 5, 10)}`}>
            <p class="eyebrow timeline-group-label">{group.label}</p>
            <div class="blur-list book-list">
              {group.items.map((book) => (
                <button
                  type="button"
                  class="blur-item book-row"
                  data-book-row
                  data-book-id={book.slug}
                  aria-haspopup="dialog"
                >
                  <span class="blur-item-left">
                    <span class="blur-item-title">{book.title}</span>
                    <span class="book-author">{book.metadata.author}</span>
                  </span>
                  <span class="blur-item-meta">{timelineMeta(book)}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    {/* Pre-rendered detail card per book — cloned into the modal on open */}
    <div hidden>
      {
        books.map((book) => (
          <template data-book-template={book.slug}>
            <div class="book-card">
              <div class="book-card-cover">
                <BookCover
                  title={book.title}
                  author={book.metadata.author}
                  spineColor={book.metadata.spineColor ?? "#333333"}
                  textColor={book.metadata.textColor ?? "#ffffff"}
                  cover={book.metadata.cover}
                />
              </div>
              <div class="book-card-body">
                <p class="eyebrow">{statusLine(book)}</p>
                <p class="book-card-title">{book.title}</p>
                <p class="book-card-author">{book.metadata.author}</p>
                {ratingOf(book) > 0 && (
                  <p class="book-card-stars">
                    <span class="stars" aria-label={`Rated ${ratingOf(book)} of 5`}>
                      <span class="stars-filled" aria-hidden="true">{"★".repeat(ratingOf(book))}</span><span class="stars-empty" aria-hidden="true">{"☆".repeat(5 - ratingOf(book))}</span>
                    </span>
                  </p>
                )}
                {book.metadata.review && <p class="book-card-review">{book.metadata.review}</p>}
                <a class="book-card-link" href={`/books/${book.slug}`}>Read full →</a>
              </div>
            </div>
          </template>
        ))
      }
    </div>

    <div class="cover-modal" id="book-modal" hidden role="dialog" aria-modal="true" aria-label="Book details">
      <div class="cover-modal-dialog" data-modal-dialog>
        <button class="cover-modal-close" type="button" aria-label="Close" data-modal-close>✕</button>
        <div class="cover-modal-mount" data-modal-mount></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ---- Shelf ---- */
  .shelf-section {
    width: 100%;
    margin-bottom: 3.5rem;
  }
  .shelf {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
    border-bottom: 2px solid var(--border);
    padding-bottom: 0;
  }
  .spine {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 180px;
    padding: 12px 0;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.04) 14%,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.18) 100%
    );
    transition: transform 0.2s ease;
  }
  .spine:nth-child(3n) { height: 188px; }
  .spine:nth-child(4n) { height: 168px; }
  .spine:hover,
  .spine:focus-visible { transform: translateY(-4px); }
  .spine:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .spine-title {
    writing-mode: vertical-rl;
    font-size: var(--text-xs);
    font-weight: 500;
    color: inherit;
    max-height: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spine-leaning {
    transform: rotate(4deg) translateY(-3px);
    transform-origin: bottom left;
    margin-left: 10px;
    margin-right: 8px;
  }
  .spine-leaning:hover,
  .spine-leaning:focus-visible { transform: rotate(4deg) translateY(-7px); }

  /* ---- Modal card (cloned from template) ---- */
  .cover-modal-mount :global(.book-card) {
    display: contents;
  }
  .cover-modal-mount :global(.book-card-cover) {
    width: 150px;
    flex-shrink: 0;
  }
  .cover-modal-mount :global(.book-card-body) {
    width: 100%;
    min-width: 0;
  }
  .cover-modal-mount :global(.book-card-title) {
    margin: 0.4rem 0 0.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.1;
    color: var(--fg);
  }
  .cover-modal-mount :global(.book-card-author) {
    margin: 0;
    font-size: var(--text-base);
    color: var(--fg-secondary);
  }
  .cover-modal-mount :global(.book-card-stars) {
    margin: 12px 0 0;
  }
  .cover-modal-mount :global(.stars) {
    font-size: var(--text-base);
    letter-spacing: 2px;
    line-height: 1;
  }
  .cover-modal-mount :global(.stars-filled) { color: var(--fg); }
  .cover-modal-mount :global(.stars-empty) { color: var(--fg-tertiary); }
  .cover-modal-mount :global(.book-card-review) {
    margin: 16px 0 0;
    font-size: var(--text-base);
    color: var(--fg-secondary);
    line-height: 1.65;
  }
  .cover-modal-mount :global(.book-card-link) {
    display: inline-block;
    margin-top: 20px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }
  .cover-modal-mount :global(.book-card-link:hover) {
    text-decoration-color: var(--fg);
  }

  /* ---- Timeline ---- */
  .timeline { width: 100%; }
  .timeline-label { margin: 0 0 20px; }
  .timeline-group { width: 100%; margin-bottom: 2.5rem; }
  .timeline-group-label { margin: 0 0 12px; }

  button.book-row {
    width: 100%;
    background: none;
    font: inherit;
    color: var(--fg);
    text-align: left;
    border-left: none;
    border-right: none;
    border-top: none;
    cursor: pointer;
  }
  .book-list button.book-row:first-child {
    border-top: 1px solid var(--border);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .book-row .blur-item-left {
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    min-width: 0;
  }
  .book-author {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .book-row .blur-item-meta {
    flex-shrink: 0;
    margin-left: 16px;
  }
</style>

<script>
  function initBookshelf() {
    const modal = document.getElementById("book-modal");
    if (!modal || modal.dataset.bound === "true") return;
    modal.dataset.bound = "true";

    const mount = modal.querySelector<HTMLElement>("[data-modal-mount]");
    const closeBtn = modal.querySelector<HTMLButtonElement>("[data-modal-close]");
    if (!mount || !closeBtn) return;

    let lastFocused: HTMLElement | null = null;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const openBook = (id: string, trigger: HTMLElement) => {
      const tpl = document.querySelector<HTMLTemplateElement>(
        `template[data-book-template="${CSS.escape(id)}"]`,
      );
      if (!tpl) return;
      mount.replaceChildren(tpl.content.cloneNode(true));
      lastFocused = trigger;
      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    };

    const closeBook = () => {
      modal.classList.remove("is-open");
      document.body.style.overflow = "";
      const finish = () => {
        modal.hidden = true;
        mount.replaceChildren();
      };
      if (reduced) finish();
      else setTimeout(finish, 220);
      lastFocused?.focus();
      lastFocused = null;
    };

    document.querySelectorAll<HTMLButtonElement>("[data-book-spine], [data-book-row]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const id = btn.dataset.bookId;
        if (id) openBook(id, btn);
      });
    });

    closeBtn.addEventListener("click", closeBook);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeBook();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) closeBook();
    });
  }

  initBookshelf();
  document.addEventListener("astro:after-swap", initBookshelf);
</script>
