---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="container">
    <!-- Logo -->
    <div class="logo animate a1">A.K</div>

    <!-- Avatar -->
    <img
      class="avatar animate"
      src="https://www.designedbyalok.com/Alok.jpeg"
      alt="Alok Kumar"
      onerror="this.style.display='none'"
    />

    <!-- Name -->
    <h1 class="name animate a2">
      <span>Alok</span>
      <span>Kumar</span>
    </h1>

    <!-- Title -->
    <p class="title animate a3">Product Designer</p>

    <!-- Bio -->
    <p class="bio animate a4">Simplifying Digital Healthcare<br />for all end-users</p>

    <!-- Work History -->
    <div class="work-list animate a5">
      <a class="work-item" href="/work/fold-health">
        <div class="work-left" style="display: flex; align-items: center; gap: 12px;">
          <img src="https://picsum.photos/seed/fold-logo/200/200" alt="Fold Health logo" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover; border: 1px solid var(--border);" />
          <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span class="work-company">Fold Health</span>
            <span class="work-years">Jun 2023 → <span class="work-dots">····</span></span>
          </div>
        </div>
        <span class="work-icon">→</span>
      </a>
      <a class="work-item" href="/work/banyan-cloud">
        <div class="work-left" style="display: flex; align-items: center; gap: 12px;">
          <img src="https://picsum.photos/seed/banyan-logo/200/200" alt="Banyan Cloud logo" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover; border: 1px solid var(--border);" />
          <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span class="work-company">Banyan Cloud</span>
            <span class="work-years">Aug 2021 → Jun 2023</span>
          </div>
        </div>
        <span class="work-icon">→</span>
      </a>
      <a class="work-item" href="/work/sentient-studio">
        <div class="work-left" style="display: flex; align-items: center; gap: 12px;">
          <img src="https://picsum.photos/seed/sentient-logo/200/200" alt="Sentient Studio logo" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover; border: 1px solid var(--border);" />
          <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span class="work-company">Sentient Studio</span>
            <span class="work-years">Oct 2020 → Jul 2021</span>
          </div>
        </div>
        <span class="work-icon">→</span>
      </a>
      <div class="work-item">
        <div class="work-left" style="display: flex; align-items: center; gap: 12px;">
          <img src="https://picsum.photos/seed/doortask-logo/200/200" alt="Doortask logo" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover; border: 1px solid var(--border);" />
          <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span class="work-company">Doortask</span>
            <span class="work-years">Jun 2018 → Jan 2020</span>
          </div>
        </div>
        <span class="work-icon">↗</span>
      </div>
    </div>

    <!-- Pages -->
    <div class="nav-list animate a6">
      <a class="nav-item" href="/work">
        <span class="nav-label">Works</span>
        <span class="nav-icon">→</span>
      </a>
      <a class="nav-item" href="/blog">
        <span class="nav-label">Blog</span>
        <span class="nav-icon">→</span>
      </a>
      <a class="nav-item" href="/resume">
        <span class="nav-label">Resume</span>
        <span class="nav-icon">→</span>
      </a>
      <a class="nav-item" href="/about">
        <span class="nav-label">About</span>
        <span class="nav-icon">→</span>
      </a>
    </div>

    <!-- Social Links -->
    <div class="links-section animate a8">
      <a class="link-pill" href="https://www.linkedin.com/in/designedbyalok/" target="_blank" rel="noopener">
        LinkedIn <span class="pill-icon">↗</span>
      </a>
      <a class="link-pill" href="https://dribbble.com/designedbyalok" target="_blank" rel="noopener">
        Dribbble <span class="pill-icon">↗</span>
      </a>
      <a class="link-pill" href="https://x.com/designedbyalok" target="_blank" rel="noopener">
        Twitter <span class="pill-icon">↗</span>
      </a>
      <a class="link-pill" href="https://github.com/designedbyalok" target="_blank" rel="noopener">
        GitHub <span class="pill-icon">↗</span>
      </a>
    </div>

    <!-- Theme Toggle -->
    <div class="theme-section animate a9">
      <span class="theme-label">Theme</span>
      <div class="theme-toggle" id="themeToggle" role="button" tabindex="0" aria-label="Toggle theme"></div>
    </div>
  </div>
</Layout>

<script>
  // Setup theme toggle
  function setupTheme() {
    const toggle = document.getElementById("themeToggle");
    const html = document.documentElement;

    if (!toggle) return;

    // Reset old listeners if running multiple times (view transitions)
    const newToggle = toggle.cloneNode(true);
    toggle.parentNode?.replaceChild(newToggle, toggle);

    newToggle.addEventListener("click", () => {
      const current = html.getAttribute("data-theme");
      const next = current === "dark" ? "light" : "dark";
      html.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });

    newToggle.addEventListener("keydown", (e: any) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        newToggle.click();
      }
    });
  }

  // Run on first load
  setupTheme();

  // Run after view transitions
  document.addEventListener("astro:after-swap", setupTheme);
</script>

<style>


  .container {
    width: 100%;
    max-width: 960px;
  }

  /* Logo */
  .logo {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--fg-secondary);
    margin-bottom: 48px;
    text-transform: uppercase;
  }

  /* Avatar */
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    object-fit: cover;
    margin-bottom: 20px;
    animation-delay: 0.05s;
  }

  /* Name */
  .name {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 2px;
  }

  .name span {
    display: block;
  }

  /* Title */
  .title {
    font-size: 14px;
    font-weight: 400;
    color: var(--fg-secondary);
    margin-top: 12px;
    margin-bottom: 6px;
  }

  /* Bio */
  .bio {
    font-size: 12px;
    font-weight: 400;
    color: var(--fg-tertiary);
    line-height: 1.6;
    margin-bottom: 40px;
  }

  /* Work Section */
  .work-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 36px;
  }

  .work-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    transition: all 0.15s ease;
  }

  a.work-item {
    cursor: pointer;
  }

  .work-item:first-child {
    border-top: 1px solid var(--border);
  }

  a.work-item:hover {
    background-color: var(--hover-bg);
    padding-left: 4px;
    padding-right: 4px;
    margin-left: -4px;
    margin-right: -4px;
  }

  .work-left {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .work-company {
    font-size: 14px;
    font-weight: 500;
    min-width: 110px;
  }

  .work-years {
    font-size: 12px;
    color: var(--fg-secondary);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .work-dots {
    color: var(--fg-tertiary);
    letter-spacing: 0.1em;
  }

  .work-icon {
    font-size: 13px;
    color: var(--fg-secondary);
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  a.work-item:hover .work-icon {
    color: var(--fg);
  }

  /* Nav Row */
  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 24px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .nav-item:first-child {
    border-top: 1px solid var(--border);
  }

  .nav-item:hover {
    background-color: var(--hover-bg);
    padding-left: 4px;
    padding-right: 4px;
    margin-left: -4px;
    margin-right: -4px;
  }

  .nav-label {
    font-size: 14px;
    font-weight: 500;
  }

  .nav-icon {
    font-size: 13px;
    color: var(--fg-secondary);
    transition: color 0.15s ease;
  }

  .nav-item:hover .nav-icon {
    color: var(--fg);
  }

  /* Links Section */
  .links-section {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--tag-bg);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 400;
    color: var(--fg);
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .link-pill:hover {
    border-color: var(--border);
    background: var(--hover-bg);
  }

  .link-pill .pill-icon {
    font-size: 11px;
    color: var(--fg-secondary);
    line-height: 1;
  }

  /* Theme Toggle */
  .theme-section {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }

  .theme-label {
    font-size: 12px;
    color: var(--fg-secondary);
    font-weight: 400;
  }

  .theme-toggle {
    position: relative;
    width: 36px;
    height: 20px;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background: var(--fg-secondary);
    border-radius: 50%;
    transition: all 0.25s ease;
  }

  :global([data-theme="dark"]) .theme-toggle::after {
    left: 18px;
    background: var(--fg);
  }

  /* Responsive */
  @media (max-width: 480px) {
    .name {
      font-size: 24px;
    }
    .container {
      max-width: 100%;
    }
    .work-company {
      min-width: 80px;
    }
  }
</style>
