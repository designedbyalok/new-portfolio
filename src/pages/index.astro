---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import GithubHeatmap from "../components/GithubHeatmap.astro";
import NowWorking from "../components/NowWorking.astro";
import NowPlaying from "../components/NowPlaying.astro";
import XProfileCard from "../components/XProfileCard.astro";
import { getAllPosts } from "../lib/cms";

// The project currently in focus — shown in the bottom-left "Currently Working
// on" widget, linking to its case study.
const nowWorking = {
  title: "WritrPro",
  sub: "Improving UX",
  href: "/work/writrpro",
  icon: "/icon-writerpro.svg",
};

const posts = (await getAllPosts()).slice(0, 5);

const fmtDate = (iso?: string) =>
  iso
    ? new Date(iso).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
      })
    : "";

// Each card links to the case study page (/work/<slug>). The detail page
// shows the "View project" link to the live URL.
const projects = [
  {
    title: "WritrPro",
    sub: "A Minimal Editor & CMS",
    href: "/work/writrpro",
    icon: "/icon-writerpro.svg",
    external: false,
  },
  {
    title: "JobStax",
    sub: "The Calm Job Tracker",
    href: "/work/jobstax",
    icon: "/icon-stax.svg",
    external: false,
  },
];

const resources = [
  { title: "Orbit Icons", sub: "Icon Library", href: "https://orbit-icons.vercel.app/" },
  { title: "Cloud Icons", sub: "Figma Community File", href: "https://www.figma.com/community/file/1114134532402635910/cloud-icons?q_id=74f63dba-8855-48ea-86a9-9b023df520de" },
];
---

<Layout
  title="Alok Kumar — Product Designer in Pune, India"
  description="Alok Kumar is a product designer based in Pune, India — currently at Fold Health, simplifying digital healthcare. Portfolio of work, case studies, and writing."
>
  <div class="home page">
    <TopBar showSearch={false} />

    <div class="home-col">
      <!-- Portrait -->
      <div class="portrait-frame animate a2">
        <img
          src="/portrait-sketch.png"
          alt="Hand-drawn portrait of Alok Kumar"
          width="396"
          height="464"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- Intro -->
      <div class="intro animate a3">
        <h1 class="home-name"><a class="home-name-link" href="/about" data-astro-prefetch="hover">Alok Kumar</a></h1>
        <p class="home-role">Product Designer, based in Pune, India.</p>

        <div class="bio">
          Currently the Product Designer at <span class="fh-wrap" data-fh-link><a class="fh-pill-link" href="https://fold.health" target="_blank" rel="noopener noreferrer"><svg class="fh-pill-logo" width="16" height="12" viewBox="0 0 150 150" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M150 75C150 82.2869 147.105 89.2753 141.953 94.4279C136.8 99.5805 129.812 102.475 122.525 102.475H75C71.0346 102.475 67.1582 103.651 63.8611 105.854C60.564 108.057 57.9942 111.189 56.4767 114.852C54.9592 118.516 54.5621 122.547 55.3358 126.436C56.1094 130.325 58.0189 133.898 60.8229 136.702C63.6268 139.506 67.1993 141.415 71.0886 142.189C74.9778 142.963 79.0091 142.566 82.6726 141.048C86.3362 139.531 89.4675 136.961 91.6706 133.664C93.8736 130.367 95.0495 126.49 95.0495 122.525V109.901C95.0495 108.916 95.4407 107.972 96.137 107.276C96.8333 106.579 97.7777 106.188 98.7624 106.188C99.7471 106.188 100.691 106.579 101.388 107.276C102.084 107.972 102.475 108.916 102.475 109.901V122.525C102.475 127.959 100.864 133.271 97.8448 137.789C94.8258 142.307 90.5348 145.829 85.5143 147.909C80.4939 149.988 74.9695 150.532 69.6398 149.472C64.3102 148.412 59.4145 145.795 55.5721 141.953C51.7296 138.11 49.1128 133.215 48.0527 127.885C46.9925 122.555 47.5367 117.031 49.6162 112.01C51.6957 106.99 55.2173 102.699 59.7356 99.6799C64.2539 96.6609 69.5659 95.0495 75 95.0495H122.525C127.842 95.0495 132.942 92.9371 136.702 89.1771C140.462 85.4171 142.574 80.3175 142.574 75C142.574 69.6825 140.462 64.5829 136.702 60.8229C132.942 57.0628 127.842 54.9505 122.525 54.9505H109.901C108.916 54.9505 107.972 54.5593 107.276 53.863C106.579 53.1667 106.188 52.2223 106.188 51.2376C106.188 50.2529 106.579 49.3085 107.276 48.6122C107.972 47.9159 108.916 47.5247 109.901 47.5247H122.525C129.812 47.5247 136.8 50.4195 141.953 55.5721C147.105 60.7247 150 67.7131 150 75ZM54.9505 62.3762C54.9505 61.3915 54.5593 60.4471 53.863 59.7508C53.1667 59.0545 52.2223 58.6634 51.2376 58.6634C50.2529 58.66