<script>
  // Lazily load the fold.health preview iframe only on first hover/focus,
  // so the homepage doesn't pull the external site on every visit.
  function initFoldPreview() {
    document.querySelectorAll<HTMLElement>("[data-fh-link]").forEach((link) => {
      if (link.dataset.fhBound === "true") return;
      link.dataset.fhBound = "true";
      const load = () => {
        const frame = link.querySelector<HTMLIFrameElement>("[data-fh-frame]");
        if (frame && !frame.src) frame.src = "https://fold.health";
      };
      link.addEventListener("mouseenter", load, { once: true });
      link.addEventListener("focusin", load, { once: true });
    });
  }

  function initPreviews() {
    initFoldPreview();
  }

  initPreviews();
  document.addEventListener("astro:after-swap", initPreviews);
</script>
