---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import { getFilms, type Film } from "../../lib/films";
import { marked } from "marked";

export async function getStaticPaths() {
  const films = await getFilms();
  return films.map((film) => ({ params: { slug: film.slug }, props: { film } }));
}

type Props = { film: Film };
const { film } = Astro.props;
const f = film.metadata;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const starParts = (rating: number): ("full" | "half" | "empty")[] =>
  Array.from({ length: 5 }, (_, i) => {
    if (rating >= i + 1) return "full";
    if (rating >= i + 0.5) return "half";
    return "empty";
  });

const byline = [f.year, f.director].filter(Boolean).join(" · ");
const watchedAt = f.watchedAt ? new Date(f.watchedAt) : undefined;
const lists = f.lists ?? [];
const htmlNotes = film.markdownContent ? marked.parse(film.markdownContent) : "";

// Movie + Review rich-results schema (star snippets in search)
const movieEntity = {
  "@type": "Movie",
  name: film.title,
  ...(f.director && { director: { "@type": "Person", name: f.director } }),
  ...(f.year && { dateCreated: String(f.year) }),
  ...(f.poster && { image: f.poster }),
};
const movieSchema =
  f.rating || f.review
    ? {
        "@context": "https://schema.org",
        "@type": "Review",
        itemReviewed: movieEntity,
        author: {
          "@type": "Person",
          name: "Alok Kumar",
          url: "https://designedbyalok.com",
        },
        ...(f.rating && {
          reviewRating: {
            "@type": "Rating",
            ratingValue: f.rating,
            bestRating: 5,
          },
        }),
        ...(f.review && { reviewBody: f.review }),
      }
    : { "@context": "https://schema.org", ...movieEntity };
---

<Layout
  title={`${film.title} (${f.year}) — Cinema — Alok Kumar`}
  headline={film.title}
  description={f.review ?? `${film.title} (${f.year})${f.director ? `, dir. ${f.director}` : ""}.`}
  article={true}
  image={`/og/films/${film.slug}.png`}
  schemas={[movieSchema]}
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/films" aria-label="Back to cinema">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <article class="film-page animate a2">
      <div class="film-page-top">
        <div class="film-page-poster">
          {f.poster ? (
            <img src={f.poster} alt={`Poster for ${film.title}`} loading="lazy" decoding="async" />
          ) : (
            <div class="film-poster-fallback" aria-hidden="true">
              <span class="film-poster-title">{film.title}</span>
              <span class="film-poster-year">{f.year}</span>
            </div>
          )}
        </div>

        <header class="film-page-head">
          <h1 class="film-page-title">{film.title}</h1>
          <p class="film-page-byline">{byline}</p>

          <div class="film-page-meta">
            {typeof f.rating === "number" && (
              <span class="stars" role="img" aria-label={`Rated ${f.rating} out of 5`}>
                {starParts(f.rating).map((p) =>
                  p === "half" ? (
                    <span class="star star-half" aria-hidden="true"><span class="star-half-fill">★</span>☆</span>
                  ) : (
                    <span class={`star star-${p}`} aria-hidden="true">{p === "full" ? "★" : "☆"}</span>
                  ),
                )}
              </span>
            )}
            {watchedAt && <span class="film-page-when">Watched {fmtDate(watchedAt)}</span>}
          </div>

          {lists.length > 0 && (
            <ul class="film-page-lists">
              {lists.map((l) => <li class="film-chip">{l}</li>)}
            </ul>
          )}
        </header>
      </div>

      <div class="film-page-content">
        {f.review && <p class="film-page-review">{f.review}</p>}

        {f.favoriteMoment && (
          <div class="film-page-field">
            <p class="eyebrow">Favorite moment</p>
            <p class="film-page-moment">{f.favoriteMoment}</p>
          </div>
        )}

        {f.recommendedFor && (
          <div class="film-page-field">
            <p class="eyebrow">Watch it if</p>
            <p>{f.recommendedFor}</p>
          </div>
        )}

        {htmlNotes && <div class="prose film-page-notes" set:html={htmlNotes}></div>}
      </div>
    </article>
  </div>
</Layout>

<style>
  .film-page {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vw, 48px);
  }
  /* Top row: poster + title/byline/meta beside it. */
  .film-page-top {
    display: grid;
    grid-template-columns: minmax(150px, 190px) 1fr;
    gap: clamp(24px, 5vw, 44px);
    align-items: center;
  }
  .film-page-head {
    min-width: 0;
  }
  @media (max-width: 640px) {
    .film-page-top {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    .film-page-poster {
      max-width: 200px;
    }
  }
  /* Everything below spans the full content width. */
  .film-page-content {
    width: 100%;
  }
  .film-page-content > :first-child {
    margin-top: 0;
  }
  .film-page-poster img,
  .film-poster-fallback {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    border: 1px solid var(--border);
    object-fit: cover;
    display: block;
  }
  .film-poster-fallback {
    background: var(--tag-bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px;
  }
  .film-poster-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--fg);
    line-height: 1.15;
  }
  .film-poster-year {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--fg-tertiary);
  }
  .film-page-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
    color: var(--fg);
  }
  .film-page-byline {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--fg-secondary);
  }
  .film-page-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 16px;
  }
  .stars { display: inline-flex; gap: 1px; font-size: var(--text-base); line-height: 1; }
  .star-full { color: var(--fg); }
  .star-empty { color: var(--fg-tertiary); }
  .star-half { position: relative; color: var(--fg-tertiary); }
  .star-half-fill { position: absolute; left: 0; top: 0; width: 52%; overflow: hidden; color: var(--fg); }
  .film-page-when { font-size: var(--text-sm); color: var(--fg-tertiary); }
  .film-page-lists {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .film-chip {
    font-size: var(--text-xs);
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tag-bg);
    color: var(--fg-secondary);
  }
  .film-page-review {
    margin: 0 0 1.75rem;
    font-size: var(--text-lg);
    color: var(--fg);
    line-height: 1.7;
  }
  .film-page-field {
    margin-top: 1.75rem;
  }
  .film-page-field .eyebrow { margin: 0 0 6px; }
  .film-page-field p:last-child { margin: 0; color: var(--fg-secondary); line-height: 1.7; }
  .film-page-moment {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--fg) !important;
  }
  .film-page-notes { margin-top: 1.75rem; }
  .film-page-notes:empty { display: none; }
</style>
