---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import { getFilms, type Film } from "../../lib/films";

const films = await getFilms();

const LIST_ORDER = [
  "Comfort Films",
  "Perfect Design Movies",
  "Favorite Sci-Fi",
  "Movies That Changed How I Think",
];

const byRatingThenYear = (a: Film, b: Film) => {
  const ra = a.metadata.rating ?? -1;
  const rb = b.metadata.rating ?? -1;
  if (rb !== ra) return rb - ra;
  return (b.metadata.year ?? 0) - (a.metadata.year ?? 0);
};

const inList = (f: Film, name: string) =>
  (f.metadata.lists ?? []).includes(name);

const sections: { name: string; films: Film[] }[] = LIST_ORDER.map((name) => ({
  name,
  films: films.filter((f) => inList(f, name)).sort(byRatingThenYear),
})).filter((s) => s.films.length > 0);

const everythingElse = films
  .filter((f) => !(f.metadata.lists ?? []).some((l) => LIST_ORDER.includes(l)))
  .sort(byRatingThenYear);

if (everythingElse.length > 0) {
  sections.push({ name: "Everything else", films: everythingElse });
}

const starParts = (rating: number): ("full" | "half" | "empty")[] =>
  Array.from({ length: 5 }, (_, i) => {
    if (rating >= i + 1) return "full";
    if (rating >= i + 0.5) return "half";
    return "empty";
  });

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const hasDetail = (f: Film) =>
  Boolean(
    f.metadata.review || f.metadata.favoriteMoment || f.metadata.recommendedFor,
  );

const watchedYear = (f: Film) =>
  f.metadata.watchedAt ? new Date(f.metadata.watchedAt).getFullYear() : undefined;
---

<Layout
  title="Cinema — Alok Kumar"
  description="Films I love — curated lists, ratings, and notes."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 3rem;">
      <h1 class="page-heading animate a2">cinema</h1>
    </div>

    {
      sections.map((section, si) => (
        <section class={`film-section animate a${Math.min(si + 3, 10)}`}>
          <p class="eyebrow film-section-label">{section.name}</p>
          <div class="blur-list film-list">
            {section.films.map((film) => {
              const panelId = `film-${slugify(section.name)}-${film.slug}`;
              const expandable = hasDetail(film);
              return (
                <div class="film-entry">
                  {expandable ? (
                    <button
                      type="button"
                      class="blur-item film-row"
                      data-film-toggle
                      aria-expanded="false"
                      aria-controls={panelId}
                    >
                      <span class="film-left">
                        <span class="blur-item-title">{film.title}</span>
                        <span class="film-byline">
                          {film.metadata.year}
                          {film.metadata.director ? ` · ${film.metadata.director}` : ""}
                        </span>
                      </span>
                      <span class="film-right">
                        {typeof film.metadata.rating === "number" ? (
                          <span
                            class="stars"
                            role="img"
                            aria-label={`Rated ${film.metadata.rating} out of 5`}
                          >
                            {starParts(film.metadata.rating).map((p) =>
                              p === "half" ? (
                                <span class="star star-half" aria-hidden="true">
                                  <span class="star-half-fill">★</span>☆
                                </span>
                              ) : (
                                <span class={`star star-${p}`} aria-hidden="true">
                                  {p === "full" ? "★" : "☆"}
                                </span>
                              ),
                            )}
                          </span>
                        ) : watchedYear(film) ? (
                          <span class="blur-item-meta">{watchedYear(film)}</span>
                        ) : null}
                      </span>
                    </button>
                  ) : (
                    <a class="blur-item film-row film-row-link" href={`/films/${film.slug}`}>
                      <span class="film-left">
                        <span class="blur-item-title">{film.title}</span>
                        <span class="film-byline">
                          {film.metadata.year}
                          {film.metadata.director ? ` · ${film.metadata.director}` : ""}
                        </span>
                      </span>
                      <span class="film-right">
                        {typeof film.metadata.rating === "number" ? (
                          <span
                            class="stars"
                            role="img"
                            aria-label={`Rated ${film.metadata.rating} out of 5`}
                          >
                            {starParts(film.metadata.rating).map((p) =>
                              p === "half" ? (
                                <span class="star star-half" aria-hidden="true">
                                  <span class="star-half-fill">★</span>☆
                                </span>
                              ) : (
                                <span class={`star star-${p}`} aria-hidden="true">
                                  {p === "full" ? "★" : "☆"}
                                </span>
                              ),
                            )}
                          </span>
                        ) : watchedYear(film) ? (
                          <span class="blur-item-meta">{watchedYear(film)}</span>
                        ) : null}
                      </span>
                    </a>
                  )}
                  {expandable && (
                    <div class="film-detail" id={panelId} data-film-panel>
                      <div class="film-detail-inner">
                        {film.metadata.review && (
                          <p class="film-review">{film.metadata.review}</p>
                        )}
                        {film.metadata.favoriteMoment && (
                          <div class="film-field">
                            <p class="eyebrow">Favorite moment</p>
                            <p class="film-moment">{film.metadata.favoriteMoment}</p>
                          </div>
                        )}
                        {film.metadata.recommendedFor && (
                          <div class="film-field">
                            <p class="eyebrow">Watch it if</p>
                            <p class="film-recommend">{film.metadata.recommendedFor}</p>
                          </div>
                        )}
                        <a class="film-page-link" href={`/films/${film.slug}`}>Full page →</a>
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .film-section {
    width: 100%;
    margin-bottom: 3rem;
  }
  .film-section-label {
    margin: 0 0 12px;
  }

  button.film-row {
    width: 100%;
    background: none;
    font: inherit;
    color: var(--fg);
    text-align: left;
    border-left: none;
    border-right: none;
    border-top: none;
    padding-block: 16px;
  }
  a.film-row-link {
    text-decoration: none;
    color: var(--fg);
  }

  .film-page-link {
    display: inline-block;
    margin-top: 18px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }
  .film-page-link:hover {
    text-decoration-color: var(--fg);
  }
  .film-entry:first-child .film-row {
    border-top: 1px solid var(--border);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .film-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .film-byline {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .film-right {
    flex-shrink: 0;
    margin-left: 16px;
  }

  .stars { display: inline-flex; gap: 1px; font-size: var(--text-sm); line-height: 1; }
  .star-full { color: var(--fg); }
  .star-empty { color: var(--fg-tertiary); }
  .star-half { position: relative; color: var(--fg-tertiary); }
  .star-half-fill { position: absolute; left: 0; top: 0; width: 52%; overflow: hidden; color: var(--fg); }

  .film-detail {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
    opacity: 0;
  }
  .film-detail.is-open { opacity: 1; }
  .film-detail-inner {
    padding: 16px 0 28px;
    border-bottom: 1px solid var(--border);
  }
  .film-review {
    margin: 0;
    max-width: 65ch;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .film-field { margin-top: 18px; }
  .film-field .eyebrow { margin: 0 0 4px; }
  .film-moment {
    margin: 0;
    max-width: 65ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--fg);
    line-height: 1.6;
  }
  .film-recommend {
    margin: 0;
    max-width: 65ch;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .film-list:hover .film-detail {
    filter: blur(3px);
    opacity: 0.4;
    transition: all 0.3s ease;
  }
  .film-list:hover .film-detail:not(.is-open) { opacity: 0; }
  .film-list .film-entry:hover .film-detail { filter: blur(0); }
  .film-list .film-entry:hover .film-detail.is-open { opacity: 1; }
</style>

<script>
  function closePanel(btn: HTMLElement, panel: HTMLElement) {
    btn.setAttribute("aria-expanded", "false");
    panel.classList.remove("is-open");
    panel.style.maxHeight = `${panel.scrollHeight}px`;
    requestAnimationFrame(() => {
      panel.style.maxHeight = "0px";
    });
  }

  function openPanel(btn: HTMLElement, panel: HTMLElement) {
    btn.setAttribute("aria-expanded", "true");
    panel.classList.add("is-open");
    panel.style.maxHeight = `${panel.scrollHeight}px`;
    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== "max-height") return;
      if (panel.classList.contains("is-open")) panel.style.maxHeight = "none";
      panel.removeEventListener("transitionend", onEnd);
    };
    panel.addEventListener("transitionend", onEnd);
  }

  function initFilmAccordions() {
    const buttons = document.querySelectorAll<HTMLElement>("[data-film-toggle]");
    buttons.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const panel = document.getElementById(
          btn.getAttribute("aria-controls") || "",
        );
        if (!panel) return;
        const isOpen = btn.getAttribute("aria-expanded") === "true";

        document
          .querySelectorAll<HTMLElement>('[data-film-toggle][aria-expanded="true"]')
          .forEach((other) => {
            if (other === btn) return;
            const otherPanel = document.getElementById(
              other.getAttribute("aria-controls") || "",
            );
            if (otherPanel) closePanel(other, otherPanel);
          });

        if (isOpen) {
          if (panel.style.maxHeight === "none") {
            panel.style.maxHeight = `${panel.scrollHeight}px`;
          }
          closePanel(btn, panel);
        } else {
          openPanel(btn, panel);
        }
      });
    });
  }

  initFilmAccordions();
  document.addEventListener("astro:after-swap", initFilmAccordions);
</script>
