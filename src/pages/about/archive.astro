---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import { getArchive, type ArchiveEntry } from "../../lib/archive";
import { marked } from "marked";

const entries = await getArchive();

const rendered = entries.map((entry) => ({
  entry,
  html: entry.markdownContent ? marked.parse(entry.markdownContent) : "",
}));

const toDate = (iso?: string) => (iso ? new Date(iso) : undefined);

const byDateDesc = (a: { entry: ArchiveEntry }, b: { entry: ArchiveEntry }) => {
  const da = toDate(a.entry.metadata.date)?.valueOf();
  const db = toDate(b.entry.metadata.date)?.valueOf();
  if (da == null && db == null) return 0;
  if (da == null) return 1;
  if (db == null) return -1;
  return db - da;
};

const groupOrder = [
  { type: "quote", label: "Quotes" },
  { type: "mental-model", label: "Mental models" },
  { type: "framework", label: "Frameworks" },
  { type: "note", label: "Notes" },
  { type: "observation", label: "Observations" },
] as const;

const groups = groupOrder
  .map((group) => ({
    ...group,
    items: rendered
      .filter((item) => item.entry.metadata.type === group.type)
      .sort(byDateDesc),
  }))
  .filter((group) => group.items.length > 0);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<Layout
  title="Archive — Alok Kumar"
  description="Notes, quotes, mental models, frameworks, and observations — a working archive."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/about" aria-label="Back to About">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 3rem;">
      <h1 class="page-heading animate a2">archive</h1>
      <p class="lede animate a3">Raw material: the ideas I keep reaching for.</p>
    </div>

    {
      groups.map((group, i) => (
        <section class={`archive-group animate a${Math.min(i + 4, 10)}`}>
          <h2 class="eyebrow group-heading">{group.label}</h2>

          {group.type === "quote" ? (
            <div class="quote-list">
              {group.items.map(({ entry, html }) => (
                <figure class="quote">
                  <blockquote class="quote-body" set:html={html}></blockquote>
                  <figcaption class="quote-source">
                    {entry.metadata.source && <span>— {entry.metadata.source}</span>}
                    <a class="quote-permalink" href={`/about/archive/${entry.slug}`} aria-label={`Open ${entry.title}`}>↗</a>
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="card-list">
              {group.items.map(({ entry, html }) => (
                <a class="entry-card" href={`/about/archive/${entry.slug}`}>
                  <div class="entry-head">
                    <h3 class="entry-title">{entry.title}</h3>
                    {entry.metadata.date && (
                      <span class="entry-date">{fmtDate(toDate(entry.metadata.date)!)}</span>
                    )}
                  </div>
                  <div class="prose entry-body" set:html={html}></div>
                  {entry.metadata.tags && entry.metadata.tags.length > 0 && (
                    <div class="entry-tags">
                      {entry.metadata.tags.map((tag) => (
                        <span class="entry-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .lede {
    margin: 12px 0 0;
    font-size: var(--text-base);
    color: var(--fg-secondary);
  }

  .archive-group {
    width: 100%;
    margin-bottom: 3rem;
  }
  .group-heading {
    margin: 0 0 1.25rem;
  }

  /* Quotes — large serif italic, no boxes */
  .quote-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .quote {
    margin: 0;
    border-left: 3px solid var(--fg);
    padding-left: 1.2em;
  }
  .quote-body {
    margin: 0;
    padding: 0;
    border: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--fg);
  }
  .quote-body :global(p) {
    margin: 0;
  }
  .quote-body :global(p + p) {
    margin-top: 0.6em;
  }
  .quote-source {
    margin: 0.75rem 0 0;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--fg-secondary);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .quote-permalink {
    color: var(--fg-tertiary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .quote-permalink:hover {
    color: var(--fg);
  }

  /* Cards — notes, mental models, frameworks, observations */
  .card-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .entry-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
    color: var(--fg);
  }
  .entry-card:hover {
    background: var(--hover-bg);
    border-color: var(--fg-tertiary);
  }
  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .entry-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.4;
  }
  .entry-date {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--fg-tertiary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .entry-body {
    font-size: var(--text-sm);
  }
  .entry-body :global(p) {
    margin: 0.65em 0 0;
  }
  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .entry-tag {
    font-size: var(--text-xs);
    background: var(--tag-bg);
    color: var(--fg-secondary);
    border-radius: 999px;
    padding: 3px 10px;
    line-height: 1.5;
  }
</style>
