---
import Layout from "../../../layouts/Layout.astro";
import TopBar from "../../../components/TopBar.astro";
import { getArchive, type ArchiveEntry } from "../../../lib/archive";
import { marked } from "marked";

export async function getStaticPaths() {
  const entries = await getArchive();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

type Props = { entry: ArchiveEntry };
const { entry } = Astro.props;
const a = entry.metadata;

const typeLabel: Record<string, string> = {
  note: "Note",
  quote: "Quote",
  "mental-model": "Mental model",
  framework: "Framework",
  observation: "Observation",
};

const date = a.date ? new Date(a.date) : undefined;
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const html = entry.markdownContent ? marked.parse(entry.markdownContent) : "";
const tags = a.tags ?? [];
---

<Layout
  title={`${entry.title} — Archive — Alok Kumar`}
  headline={entry.title}
  description={`${typeLabel[a.type]}${a.source ? ` · ${a.source}` : ""} — from Alok Kumar's archive.`}
  article={true}
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/about/archive" aria-label="Back to archive">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <article class="archive-entry animate a2">
      <p class="eyebrow">{typeLabel[a.type]}</p>
      <h1 class="archive-entry-title">{entry.title}</h1>

      {(a.source || date) && (
        <p class="archive-entry-meta">
          {a.source}
          {a.source && date && " · "}
          {date && fmtDate(date)}
        </p>
      )}

      <div class:list={["prose", "archive-entry-body", a.type === "quote" && "is-quote"]} set:html={html}></div>

      {tags.length > 0 && (
        <div class="archive-entry-tags">
          {tags.map((tag) => <span class="entry-tag">{tag}</span>)}
        </div>
      )}
    </article>
  </div>
</Layout>

<style>
  .archive-entry {
    width: 100%;
    max-width: 65ch;
  }
  .archive-entry-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.5rem;
    color: var(--fg);
  }
  .archive-entry-meta {
    margin: 0 0 1.5rem;
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .archive-entry-body.is-quote :global(p) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-2xl);
    line-height: 1.4;
    color: var(--fg);
  }
  .archive-entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2rem;
  }
  .entry-tag {
    font-size: var(--text-xs);
    background: var(--tag-bg);
    color: var(--fg-secondary);
    border-radius: 999px;
    padding: 3px 10px;
    line-height: 1.5;
  }
</style>
