---
// Case studies — same row-list layout as the blog and work-experience pages.
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import { getIdeas } from "../../lib/ideas";

const entries = await getIdeas();

const yearOf = (period: string) => {
  const m = period.match(/(\d{4})(?!.*\d{4})/);
  return m ? m[1] : "";
};
---

<Layout
  title="Case Studies — Alok Kumar"
  description="In-depth product design case studies — research, decisions, and outcomes."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 3rem;">
      <h1 class="page-heading animate a2">case studies</h1>
    </div>

    <div class="blur-list animate a3">
      {
        entries.map((e) => (
          <a class="blur-item" href={`/case-studies/${e.slug}`} data-astro-prefetch="hover">
            <div class="blur-item-left">
              {e.metadata.hero ? (
                <img class="thumb-frame" src={e.metadata.hero} alt="" width="64" height="40" loading="lazy" decoding="async" />
              ) : (
                <div class="thumb-frame" aria-hidden="true"></div>
              )}
              <span class="blur-item-text">
                <span class="blur-item-title">{e.title}</span>
                <span class="blur-item-sub">{e.metadata.tagline}</span>
              </span>
            </div>
            <span class="blur-item-meta">{yearOf(e.metadata.period)}</span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  /* Title + one-line tagline stacked inside the shared row layout. */
  .blur-item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .blur-item-sub {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
