---
// Ideas — a home for future explorations and experiments. The in-depth work
// lives under /case-studies; this page collects the looser, playful stuff.
// Currently an intentional empty state until entries exist.
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
---

<Layout
  title="Ideas — Alok Kumar"
  description="Explorations, experiments, and ideas in progress."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 1.5rem;">
      <h1 class="page-heading animate a2">ideas</h1>
    </div>

    <div class="ideas-empty animate a3">
      <div class="ideas-empty-card" aria-hidden="true">
        <span class="spark">✦</span>
      </div>
      <p class="ideas-empty-title">Nothing here yet — on purpose.</p>
      <p class="ideas-empty-copy">
        This is where the looser explorations will live: experiments, sketches,
        and half-formed things worth sharing before they're finished. For the
        in-depth work, see the <a href="/case-studies">case studies</a>.
      </p>
    </div>
  </div>
</Layout>

<style>
  .ideas-empty {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 48px 24px 24px;
  }
  .ideas-empty-card {
    width: 120px;
    height: 120px;
    border-radius: 24px;
    border: 1px dashed var(--border);
    background: var(--tag-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .spark {
    font-size: 28px;
    color: var(--fg-tertiary);
    animation: sparkFloat 3s ease-in-out infinite;
  }
  @keyframes sparkFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.7; }
    50% { transform: translateY(-6px) rotate(12deg); opacity: 1; }
  }
  .ideas-empty-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--text-xl);
    color: var(--fg);
    margin: 0 0 8px;
  }
  .ideas-empty-copy {
    max-width: 44ch;
    margin: 0;
    font-size: var(--text-base);
    color: var(--fg-secondary);
    line-height: 1.6;
  }
  .ideas-empty-copy a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }
  .ideas-empty-copy a:hover {
    text-decoration-color: var(--fg);
  }
</style>
