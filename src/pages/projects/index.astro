---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Projects — Alok Kumar"
  description="Projects worth telling you about: idea, problem, solution, and why it was unique."
>
  <div class="container container-content page">
    <div class="top-bar animate a1" style="margin-bottom: 24px;">
      <a href="/" aria-label="Home">
        <img src="/favicon.svg" alt="Alok Logo" class="logo-avatar" style="margin-bottom: 0; width: 48px; height: 48px;" />
      </a>
    </div>
    <div style="width: 100%; margin-bottom: 2rem;">
      <h1 class="name animate a2">Projects</h1>
      <p class="title animate a3">Projects worth telling you about.</p>
    </div>

    <div class="work-list animate a3" style="width: 100%;">
      {
        entries.map((entry) => (
          <a class="work-item" href={`/projects/${entry.id}`}>
            <div class="work-left" style="flex-direction: column; align-items: flex-start; gap: 4px;">
              <span class="nav-label">{entry.data.title}</span>
              <span class="work-years">{entry.data.tagline}</span>
            </div>
            <span class="work-icon">→</span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
