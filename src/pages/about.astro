---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import ListeningTo from "../components/ListeningTo.astro";
import GithubHeatmap from "../components/GithubHeatmap.astro";
import { Image } from "astro:assets";

type Photo = { src: string; aspect: string; caption: string; alt?: string };

const portrait: Photo = {
  src: "https://picsum.photos/seed/alok-portrait/900/1100",
  aspect: "4 / 5",
  caption: "Pune, 2024.",
};

const friends: Photo[] = [
  {
    src: "https://picsum.photos/seed/about-friends-1/900/1100",
    aspect: "4 / 5",
    caption: "Coffee with Adi, 2024",
  },
  {
    src: "https://picsum.photos/seed/about-trip-vagamon/1200/800",
    aspect: "3 / 2",
    caption: "Vagamon, Kerala — 2023",
  },
  {
    src: "https://picsum.photos/seed/about-fold-offsite/1000/1000",
    aspect: "1 / 1",
    caption: "At the Fold offsite, 2024",
  },
  {
    src: "https://picsum.photos/seed/about-bdw/1200/800",
    aspect: "3 / 2",
    caption: "Bangalore design week",
  },
  {
    src: "https://picsum.photos/seed/about-himachal/900/1100",
    aspect: "4 / 5",
    caption: "Trekking in Himachal",
  },
  {
    src: "https://picsum.photos/seed/about-desk/1000/1000",
    aspect: "1 / 1",
    caption: "Sketching at the desk",
  },
];

const movies = [
  { label: "Recently loved", value: "Past Lives (2023)" },
  { label: "Forever", value: "In the Mood for Love (2000)" },
  { label: "Comfort rewatch", value: "Before Sunrise (1995)" },
];

const books = [
  { label: "Reading now", value: "The Design of Everyday Things — Don Norman" },
  { label: "Recently", value: "Four Thousand Weeks — Oliver Burkeman" },
  { label: "Reread", value: "Steal Like an Artist — Austin Kleon" },
];

const legos: Photo = {
  src: "https://picsum.photos/seed/about-legos/900/1100",
  aspect: "4 / 5",
  caption: "Eiffel Tower, in pieces on the dining table.",
};

const art: Photo[] = [
  { src: "https://picsum.photos/seed/about-art-1/1000/1000", aspect: "1 / 1", caption: "Ink, 2024" },
  { src: "https://picsum.photos/seed/about-art-2/1000/1000", aspect: "1 / 1", caption: "Pen on Moleskine, 2023" },
  { src: "https://picsum.photos/seed/about-art-3/1000/1000", aspect: "1 / 1", caption: "Watercolor study, 2024" },
  { src: "https://picsum.photos/seed/about-art-4/1000/1000", aspect: "1 / 1", caption: "Charcoal, 2022" },
];

const photography: Photo[] = [
  { src: "https://picsum.photos/seed/photo-pune/1200/800", aspect: "3 / 2", caption: "Pune morning, 2024" },
  { src: "https://picsum.photos/seed/photo-goa/900/1100", aspect: "4 / 5", caption: "Goa, 2023" },
  { src: "https://picsum.photos/seed/photo-kerala/1000/1000", aspect: "1 / 1", caption: "Backwaters, Kerala" },
  { src: "https://picsum.photos/seed/photo-street/1000/1000", aspect: "1 / 1", caption: "Streetlight study" },
  { src: "https://picsum.photos/seed/photo-mumbai/1200/800", aspect: "3 / 2", caption: "Window, Mumbai" },
  { src: "https://picsum.photos/seed/photo-delhi/900/1100", aspect: "4 / 5", caption: "Old Delhi" },
];
---

<Layout
  title="About — Alok Kumar"
  description="The things I think about when I'm not designing."
>
  <div class="container-edge container-content page about">
    <!-- Logo -->
    <TopBar />
    <div class="top-bar-wrapper animate a1" style="margin-bottom: 24px; position: sticky; top: 32px; z-index: 100; width: fit-content;">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <header class="about-header" style="margin-top: 1rem; margin-bottom: 4rem;">
      <p class="eyebrow">About</p>
      <h1 class="display display-lg text-balance">Off-screen.</h1>
      <p class="lede text-pretty">
        The things I think about when I'm not designing. The photos, the music,
        the books, the small obsessions.
      </p>
    </header>

    <section class="section animate a2">
      <div class="hero-card">
        <div class="hero-image-wrapper">
          <Image
            src={portrait.src}
            alt="Portrait of Alok Kumar"
            width={800} height={1000}
            class="hero-image"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-content">
          <h2 class="hero-title">Hey, I'm Alok<span style="color: var(--accent);">.</span></h2>
          <p class="bio-text">
            I've been designing websites and apps for years, working with startups and small teams to deliver holistic, impactful solutions. With a background in Computer Science, product design has become a fast and flexible part of my work — allowing for efficient projects that contribute to increased visibility and better user experiences. Further I'm driven by a broad interest in creative fields like architecture, photography, branding, and digital products.
          </p>
          <p class="bio-text bio-cta">
            So if you're looking for a product designer <span class="highlight">for fast, high-quality, and distinctive experiences,</span> drop me a mail or reach out via my socials.
          </p>
          
          <div class="hero-socials">
            <h3>Contact & Socials</h3>
            <div class="social-links">
              <a href="mailto:designedbyalok@gmail.com" class="social-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><path d="M3 8l9 6 9-6"></path></svg>
                designedbyalok@gmail.com
              </a>
              <a href="https://x.com/designedbyalok" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Twitter">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/designedbyalok/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="eyebrow">In the world</p>
      <ul class="gallery gallery-3">
        {
          friends.map((item) => (
            <li>
              <figure>
                <div class="photo-frame" style={`aspect-ratio: ${item.aspect};`}>
                  <Image
                    src={item.src}
                    alt={item.alt ?? item.caption}
                    width={1200} height={1200}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="gallery-caption">{item.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <p class="eyebrow">Music</p>
      <p class="section-lede">
        Mostly post-rock and instrumental at the desk — Tycho, Mogwai, Nils Frahm.
        Anything with mood and few words.
      </p>
      <ListeningTo />
    </section>

    <section class="section section-prose">
      <p class="eyebrow">Movies</p>
      <p class="section-lede">
        I prefer the long, slow ones — directors who trust the audience to sit
        with a frame.
      </p>
      <dl class="dlist">
        {
          movies.map((item) => (
            <div class="dlist-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
      <a class="more-link" href="/films">The full cinema list →</a>
    </section>

    <section class="section section-prose">
      <p class="eyebrow">Books</p>
      <p class="section-lede">
        Nonfiction-heavy, a little philosophy, the occasional novel.
      </p>
      <dl class="dlist">
        {
          books.map((item) => (
            <div class="dlist-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
      <a class="more-link" href="/books">The bookshelf →</a>
    </section>

    <section class="section">
      <GithubHeatmap />
    </section>

    <section class="section section-prose">
      <p class="eyebrow">Archive</p>
      <p class="section-lede">
        Notes, quotes, mental models — the raw material I keep reaching for.
      </p>
      <a class="more-link" href="/about/archive">Browse the archive →</a>
    </section>

    <section class="section section-legos">
      <p class="eyebrow">Legos</p>
      <div class="me-grid">
        <figure class="photo-frame" style={`aspect-ratio: ${legos.aspect};`}>
          <Image
            src={legos.src}
            alt={legos.caption}
            width={1200} height={1200}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="me-text">
          <p>
            I collect a few sets a year — usually architecture or technic. The
            Eiffel Tower is currently in pieces on the dining table.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="eyebrow">Art</p>
      <ul class="gallery gallery-4">
        {
          art.map((item) => (
            <li>
              <figure>
                <div class="photo-frame" style={`aspect-ratio: ${item.aspect};`}>
                  <Image
                    src={item.src}
                    alt={item.caption}
                    width={1200} height={1200}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="gallery-caption">{item.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <p class="eyebrow">Photography</p>
      <ul class="gallery gallery-3">
        {
          photography.map((item) => (
            <li>
              <figure>
                <div class="photo-frame" style={`aspect-ratio: ${item.aspect};`}>
                  <Image
                    src={item.src}
                    alt={item.caption}
                    width={1200} height={1200}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="gallery-caption">{item.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="about-footer">
      <hr />
      <p class="eyebrow">Reach me</p>
      <p class="footer-lede">
        Always up to talk — design, music, books, or whatever else.
      </p>
      <p class="footer-links">
        <a href="mailto:designedbyalok@gmail.com" class="link link-accent"
          >designedbyalok@gmail.com</a
        >
        <span aria-hidden="true">·</span>
        <a
          href="https://x.com/designedbyalok"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-accent">Twitter</a
        >
        <span aria-hidden="true">·</span>
        <a
          href="https://www.linkedin.com/in/designedbyalok/"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-accent">LinkedIn</a
        >
      </p>
    </footer>
  </div>
</Layout>

<style>
  .about {
    padding-block: clamp(4rem, 8vw, 7rem) clamp(4rem, 8vw, 6rem);
  }

  .about-header {
    max-width: 60ch;
    margin-bottom: clamp(4rem, 8vw, 6rem);
  }
  .about-header .display {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--text-4xl);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: var(--fg);
  }
  .about-header .lede {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    color: var(--fg-secondary);
    line-height: 1.55;
  }

  .more-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-secondary);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .more-link:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .section {
    margin-top: clamp(4rem, 8vw, 6rem);
  }
  .section-prose {
    max-width: 65ch;
  }
  .section > .eyebrow {
    margin-bottom: 1.25rem;
  }
  .section-lede {
    margin: 0 0 1.75rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 380;
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--fg-secondary);
    max-width: 50ch;
  }

  /* Photo frames — used everywhere on this page */
  figure {
    margin: 0;
  }
  .photo-frame {
    overflow: hidden;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    display: block;
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.2, 0, 0, 1);
  }
  .gallery li:hover .photo-frame img,
  .section-me .photo-frame:hover img,
  .section-legos .photo-frame:hover img {
    transform: scale(1.02);
  }

  /* Hero Section (New Design) */
  .hero-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 2rem;
  }
  [data-theme="dark"] .hero-card {
    /* No background or shadow */
  }

  @media (min-width: 768px) {
    .hero-card {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 280px; /* Allow shrinking on very small screens */
    margin: 0 auto;
    padding: 6px;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    box-shadow: 0 24px 48px -12px rgba(0,0,0,0.15);
    transform: rotate(-3deg);
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1);
    z-index: 2;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .hero-image-wrapper {
      margin-left: 0;
      margin-right: 0;
    }
  }
  [data-theme="dark"] .hero-image-wrapper {
    background: #2a2a2a;
    border-color: rgba(255,255,255,0.1);
    box-shadow: 0 24px 48px -12px rgba(0,0,0,0.5);
  }
  .hero-image-wrapper:hover {
    transform: rotate(0deg) scale(1.02);
  }
  .hero-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }

  .hero-content {
    flex: 1;
  }
  .hero-content .hero-title {
    font-size: var(--text-4xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    color: var(--fg);
  }
  .hero-content .bio-text {
    font-size: var(--text-base);
    color: var(--fg-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .hero-content .bio-cta {
    margin-bottom: 32px;
  }
  .hero-content .highlight {
    color: var(--fg);
    font-weight: 500;
  }

  .hero-socials {
    margin-top: 16px;
  }
  .hero-socials h3 {
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--fg);
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .social-link:hover {
    color: var(--fg);
  }

  /* Galleries */
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .gallery-3 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .gallery-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .gallery-3 { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  .gallery-4 {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 720px) {
    .gallery-4 { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  }
  .gallery-caption {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--fg-secondary);
    line-height: 1.4;
  }

  /* Side-by-side blocks (Legos) */
  .me-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 720px) {
    .me-grid {
      grid-template-columns: 40% 1fr;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
  .me-text p {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 380;
    font-size: var(--text-xl);
    line-height: 1.45;
    max-width: 45ch;
    color: var(--fg);
  }

  /* Description lists */
  .dlist {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .dlist-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .dlist-row dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-secondary);
    margin: 0;
  }
  .dlist-row dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--fg);
    line-height: 1.4;
  }

  /* Footer */
  .about-footer {
    margin-top: clamp(4rem, 8vw, 6rem);
  }
  .about-footer hr {
    margin-bottom: 2.5rem;
  }
  .about-footer .eyebrow {
    margin-bottom: 1rem;
  }
  .footer-lede {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--fg);
    font-weight: 380;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    align-items: center;
    font-size: var(--text-sm);
    margin: 0;
  }
  .footer-links span[aria-hidden] {
    color: var(--fg-tertiary);
  }
  .link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
  }
  .link:hover {
    text-decoration-color: var(--fg);
  }
</style>
