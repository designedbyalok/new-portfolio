---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import { getAllPosts } from "../../lib/cms";

const posts = await getAllPosts();

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<Layout
  title="Blog — Alok Kumar"
  description="Notes from the desk — design, healthcare, and building things."
>
  <div class="container container-content page" style="align-items: flex-start; justify-content: flex-start;">
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/" aria-label="Back Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    <div style="width: 100%; margin-bottom: 3rem;">
      <h1 class="page-heading animate a2">words</h1>
    </div>

    <div class="blur-list animate a3">
      {
        posts.map((post) => (
          <a class="blur-item" href={`/blog/${post.slug}`} data-astro-prefetch="hover">
            <div class="blur-item-left">
              {post.thumbnail ? (
                <img class="thumb-frame" src={post.thumbnail} alt="" width="64" height="40" loading="lazy" decoding="async" />
              ) : (
                <div class="thumb-frame" aria-hidden="true"></div>
              )}
              <span class="blur-item-title">{post.title}</span>
            </div>
            <span class="blur-item-meta">{post.date ? fmtDate(new Date(post.date)) : ""}</span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
