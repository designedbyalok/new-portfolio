---
import Layout from "../../layouts/Layout.astro";
import LikeButton from "../../components/LikeButton.astro";
import Comments from "../../components/Comments.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${post.data.title} — Alok Kumar`}
  description={post.data.description}
>
  <article>
    <header class="container-edge container-prose post-header">
      <p class="eyebrow post-meta">
        Blog · {formattedDate}
        {post.data.readTime && ` · ${post.data.readTime}`}
      </p>
      <h1
        class="display display-lg post-title text-balance"
        transition:name={`post-title-${post.id}`}
      >
        {post.data.title}
      </h1>
      <p class="post-lede text-pretty">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <ul class="post-tags">
            {post.data.tags.map((tag) => (
              <li class="post-tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.thumbnail && (
        <div class="container-edge container-content post-hero-image">
          <img
            src={post.data.thumbnail}
            alt={post.data.title}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="container-edge container-prose post-body">
      <div class="prose">
        <Content />
      </div>
    </div>

    <div class="container-edge container-prose post-actions">
      <LikeButton slug={post.id} />
    </div>

    <div class="container-edge container-prose">
      <Comments slug={post.id} />
    </div>

    <footer class="container-edge container-prose post-footer">
      <hr />
      <p class="eyebrow">Notes</p>
      <p class="post-thanks">Thanks for reading.</p>
      <p class="post-contact">
        If anything caught your eye — write to me at <a
          href="mailto:designedbyalok@gmail.com"
          class="link link-accent">designedbyalok@gmail.com</a
        >.
      </p>
      <a href="/blog" class="link link-accent post-back">← All notes</a>
    </footer>
  </article>
</Layout>

<style>
  .post-header {
    padding-block: clamp(5rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }
  .post-meta {
    margin-bottom: 1.5rem;
  }
  .post-title {
    margin: 0;
    line-height: 0.98;
  }
  .post-lede {
    margin: 1.8rem auto 0;
    max-width: 52ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 380;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .post-tags {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.5rem;
  }
  .post-tag {
    font-size: var(--text-2xs);
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .post-hero-image {
    margin-block: 2rem 3rem;
  }
  .post-hero-image :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
  }

  .post-body {
    padding-block: 1rem;
  }

  .post-actions {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  .post-footer {
    padding-block: 2rem 6rem;
  }
  .post-footer hr {
    margin-bottom: 2.5rem;
  }
  .post-thanks {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--ink);
  }
  .post-contact {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    font-size: var(--text-base);
  }
  .post-back {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }
</style>
