---
import Layout from "../../layouts/Layout.astro";
import LikeButton from "../../components/LikeButton.astro";
import Comments from "../../components/Comments.astro";
import { Image } from "astro:assets";
import { getAllPosts } from "../../lib/cms";
import type { CMSPost } from "../../lib/cms";
import { marked } from "marked";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CMSPost };
const { post } = Astro.props;

const htmlContent = marked.parse(post.markdownContent);

const formattedDate = post.date
  ? new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "long" })
  : "Recently";
---

<Layout
  title={`${post.title} — Alok Kumar`}
  description={post.description || ""}
>
  <div class="container-edge container-prose page blog-post-page" style="align-items: flex-start; justify-content: flex-start; position: relative;">
    <div class="top-bar-wrapper animate a1">
      <a class="back-link-circle" href="/blog" aria-label="Back to Notes">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    {
      post.thumbnail && (
        <div class="post-hero-image animate a2">
          <Image
            src={post.thumbnail}
            alt={post.title}
            width={1200} height={800}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <header class="post-header animate a3">
      <h1 class="post-title">{post.title}</h1>
      <p class="post-date">{formattedDate}</p>
    </header>

    <div class="prose animate a4" set:html={htmlContent}></div>

    <div class="post-actions animate a5" style="margin-top: 40px; display: flex; justify-content: center; width: 100%;">
      <LikeButton slug={post.slug} />
    </div>

    <div class="post-comments animate a6" style="margin-top: 40px; width: 100%;">
      <Comments slug={post.slug} />
    </div>
  </div>
</Layout>

<style>
  .blog-post-page {
    padding-top: 32px !important;
    padding-bottom: 120px;
  }

  .top-bar-wrapper {
    margin-bottom: 32px;
  }

  @media (min-width: 1024px) {
    .top-bar-wrapper {
      position: absolute;
      left: -60px;
      top: 32px; /* Align with the top padding */
      margin-bottom: 0;
    }
  }

  .post-hero-image {
    margin-bottom: 40px;
    width: 100%;
  }
  .post-hero-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    background: #ffffff;
    padding: 12px;
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  [data-theme="dark"] .post-hero-image :global(img) {
    padding: 12px;
    background: #ffffff; /* Keep the polaroid look in dark mode */
    border-color: rgba(255,255,255,0.1);
  }

  .post-header {
    margin-bottom: 40px;
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-style: italic;
    font-weight: 500;
    color: var(--fg);
    margin-bottom: 0.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .post-date {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--fg-secondary);
  }
</style>
