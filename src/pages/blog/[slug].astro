---
import "@fontsource/jetbrains-mono/400.css";
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import LikeButton from "../../components/LikeButton.astro";
import { getAllPosts } from "../../lib/cms";
import type { CMSPost } from "../../lib/cms";
import { marked } from "marked";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CMSPost };
const { post } = Astro.props;

// The layout already renders the post title as the page <h1>. Post bodies are
// authored inconsistently (some start at #, some at ###), so normalize every
// body so its shallowest heading becomes <h2> — keeps one h1 per page and a
// clean heading outline regardless of how the author wrote it.
function renderPostBody(markdown: string): string {
  const tokens = marked.lexer(markdown);
  let min = 6;
  marked.walkTokens(tokens, (t) => {
    if (t.type === "heading") min = Math.min(min, t.depth);
  });
  if (min < 6) {
    const offset = 2 - min;
    if (offset !== 0) {
      marked.walkTokens(tokens, (t) => {
        if (t.type === "heading") {
          t.depth = Math.max(2, Math.min(6, t.depth + offset));
        }
      });
    }
  }
  return marked.parser(tokens);
}

const htmlContent = renderPostBody(post.markdownContent);

const formattedDate = post.date
  ? new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "long" })
  : "Recently";
---

<Layout
  title={`${post.title} — Alok Kumar`}
  headline={post.title}
  description={post.description}
  article={true}
  publishDate={post.date || undefined}
  modifiedDate={post.updated || undefined}
  image={post.thumbnail || `/og/blog/${post.slug}.png`}
>
  <div class="container-edge container-prose page blog-post-page" style="align-items: flex-start; justify-content: flex-start; position: relative; padding: 0;">
    <!-- Logo -->
    <TopBar />
    <div class="back-wrapper animate a1">
      <a class="back-link-circle" href="/blog" aria-label="Back to Notes">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
    </div>

    {
      post.thumbnail && (
        <div class="post-hero-image animate a2">
          <img
            src={post.thumbnail}
            alt={post.title}
            width="1200"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <header class="post-header animate a3">
      <h1 class="post-title">{post.title}</h1>
      <p class="post-date">{formattedDate}</p>
    </header>

    <div class="prose animate a4" set:html={htmlContent}></div>

    <div class="post-actions animate a5" style="margin-top: 40px; display: flex; justify-content: center; width: 100%;">
      <LikeButton slug={post.slug} />
    </div>
  </div>
</Layout>

<style is:global>
  main#main:has(.blog-post-page) {
    padding: var(--page-pad-top) var(--container-pad-x);
  }
</style>

<style>
  .blog-post-page {
    padding-bottom: 0;
  }

  .post-hero-image {
    margin-bottom: 40px;
    width: 100%;
  }
  .post-hero-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    background: #ffffff;
    padding: 12px;
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  [data-theme="dark"] .post-hero-image :global(img) {
    padding: 12px;
    background: #ffffff; /* Keep the polaroid look in dark mode */
    border-color: rgba(255,255,255,0.1);
  }

  .post-header {
    margin-bottom: 40px;
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-style: italic;
    font-weight: 500;
    color: var(--fg);
    margin-bottom: 0.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .post-date {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--fg-secondary);
  }
</style>
