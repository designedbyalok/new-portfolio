---
interface Props {
  slug: string;
}
const { slug } = Astro.props;

// To enable real comments, replace the placeholders below with your real
// Giscus config from https://giscus.app/ and remove the `data-stub` div.
const GISCUS = {
  repo: "designedbyalok/new-portfolio",
  repoId: "R_kgDOSlp4tQ",
  category: "General",
  categoryId: "DIC_kwDOSlp4tc4C-0wu",
};

const enabled =
  GISCUS.repoId !== "REPLACE_WITH_REPO_ID" &&
  GISCUS.categoryId !== "REPLACE_WITH_CATEGORY_ID";
---

<section class="comments" aria-label="Comments">
  <hr />
  <p class="eyebrow">Comments</p>

  {
    enabled ? (
      <div class="giscus-mount">
        <script
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="en"
          crossorigin="anonymous"
          async
        />
      </div>
    ) : (
      <div class="comments-stub" data-stub>
        <p class="stub-body">
          Comments are powered by{" "}
          <a
            href="https://giscus.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="link link-accent"
          >
            Giscus
          </a>{" "}
          + GitHub Discussions. Once the repo is public and Giscus is configured,
          they appear here.
        </p>
        <p class="stub-cta">
          Until then — write to me at{" "}
          <a
            href={`mailto:designedbyalok@gmail.com?subject=Re: ${slug}`}
            class="link link-accent"
          >
            designedbyalok@gmail.com
          </a>
          .
        </p>
      </div>
    )
  }
</section>

<style>
  .comments {
    margin-top: 4rem;
  }
  .comments hr {
    margin-bottom: 2.5rem;
  }
  .comments > .eyebrow {
    margin-bottom: 1.5rem;
  }

  .giscus-mount {
    min-height: 240px;
  }

  .comments-stub {
    border: 1px dashed var(--rule);
    border-radius: 6px;
    padding: 1.6rem 1.8rem;
    background: color-mix(in oklab, var(--paper-deep) 60%, transparent);
  }
  .stub-body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink);
  }
  .stub-cta {
    margin: 1rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
