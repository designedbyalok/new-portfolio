---
// "Listening to..." — Spotify shelf + detail card.
// Data comes from /api/spotify.json client-side; everything inside the card
// is re-rendered with innerHTML, so injected nodes are styled via :global
// selectors nested under the scoped .lt-card parent (same pattern as
// GithubHeatmap.astro).
---

<section class="lt" data-pagefind-ignore>
  <div class="lt-card" data-lt-card>
    <div class="lt-inner">
      <div class="lt-head">
        <h3 class="lt-title">Listening to&hellip;</h3>
        <button type="button" class="lt-pill" data-lt-action="refresh">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"
            ></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"
            ></path></svg
          >
          <span>Refresh</span>
        </button>
      </div>
      <p class="lt-quiet">Loading&hellip;</p>
    </div>
  </div>
</section>

<script>
  type Track = {
    title: string;
    artist: string;
    album: string;
    coverImage: string;
    songUrl: string;
    previewUrl: string | null;
    progressMs?: number;
    durationMs?: number;
  };
  type ListeningData = { isPlaying: boolean; current: Track | null; recent: Track[] };

  const API_URL = "/api/spotify.json";
  const MAX_FAN = 8;

  const ICON_REFRESH =
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>';
  const ICON_SPOTIFY =
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>';
  const ICON_PREV =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zM18 6v12l-9-6z"/></svg>';
  const ICON_NEXT =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 6h2v12h-2zM6 6v12l9-6z"/></svg>';
  const ICON_PLAY =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>';
  const ICON_PAUSE =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 5.5h3.5v13H7.5zM13 5.5h3.5v13H13z"/></svg>';

  const ESC: Record<string, string> = {
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  };
  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ESC[c] ?? c);
  }
  function cssUrl(u: string): string {
    return u.replace(/[\\"'()\s]/g, (c) => "\\" + c);
  }
  function fmt(sec: number): string {
    if (!Number.isFinite(sec) || sec < 0) sec = 0;
    const s = Math.floor(sec % 60);
    return Math.floor(sec / 60) + ":" + String(s).padStart(2, "0");
  }

  // One shared <audio> element for the whole page, created lazily (never on load).
  let warned = false;
  let audio: HTMLAudioElement | null = null;
  let audioKey = "";
  const audioWatchers = new Set<() => void>();

  function ensureAudio(): HTMLAudioElement {
    if (audio) return audio;
    const a = new Audio();
    a.preload = "none";
    const notify = () => audioWatchers.forEach((fn) => fn());
    ["play", "pause", "timeupdate", "durationchange", "loadedmetadata"].forEach((ev) =>
      a.addEventListener(ev, notify)
    );
    a.addEventListener("ended", () => {
      a.currentTime = 0; // reset on ended
      notify();
    });
    audio = a;
    return a;
  }

  function stopAudio() {
    if (!audio) return;
    if (!audio.paused) audio.pause();
    if (audio.src) audio.currentTime = 0;
  }

  function setupCard(card: HTMLElement) {
    let data: ListeningData = { isPlaying: false, current: null, recent: [] };
    let fan: Track[] = [];
    let mode: "shelf" | "detail" = "shelf";
    let detailIdx = 0;

    const trackKey = (t: Track) => t.songUrl || t.title + "|" + t.artist;
    const playLabel = (t: Track) => (t.previewUrl ? "Play preview" : "Play on Spotify");

    function shelfHeader(): string {
      return (
        '<div class="lt-head"><h3 class="lt-title">Listening to&hellip;</h3>' +
        '<button type="button" class="lt-pill" data-lt-action="refresh">' +
        ICON_REFRESH +
        "<span>Refresh</span></button></div>"
      );
    }

    function detailHeader(t: Track): string {
      return (
        '<div class="lt-head">' +
        '<button type="button" class="lt-pill" data-lt-action="back">&lsaquo; Back</button>' +
        '<a class="lt-pill" href="' +
        esc(t.songUrl) +
        '" target="_blank" rel="noopener noreferrer">' +
        ICON_SPOTIFY +
        "<span>See on Spotify &#8599;</span></a></div>"
      );
    }

    function coverHtml(t: Track, i: number): string {
      const style =
        "--z:" +
        (fan.length - i) +
        ";" +
        (t.coverImage ? '--cover:url("' + cssUrl(t.coverImage) + '")' : "");
      const img = t.coverImage
        ? '<img class="lt-cover-img" src="' +
          esc(t.coverImage) +
          '" alt="" width="150" height="150" loading="lazy" />'
        : '<span class="lt-cover-img lt-cover-blank"></span>';
      return (
        '<button type="button" class="lt-cover' +
        (i === 0 ? " lt-active" : "") +
        '" data-lt-action="open" data-lt-index="' +
        i +
        '" aria-label="' +
        esc(t.artist + " — " + t.title) +
        '" style="' +
        esc(style) +
        '">' +
        '<span class="lt-tip" aria-hidden="true"><span class="lt-tip-artist">' +
        esc(t.artist) +
        '</span><span class="lt-tip-title">' +
        esc(t.title) +
        "</span></span>" +
        img +
        "</button>"
      );
    }

    function renderShelf(focusIdx?: number) {
      mode = "shelf";
      stopAudio();
      let body: string;
      if (fan.length === 0) {
        body = '<p class="lt-quiet">Not listening right now.</p>';
      } else {
        body =
          (!data.current ? '<p class="lt-sub">Recently enjoyed:</p>' : "") +
          '<div class="lt-fan" role="group" aria-label="Album shelf">' +
          fan.map(coverHtml).join("") +
          "</div>";
      }
      card.innerHTML = '<div class="lt-inner lt-fade">' + shelfHeader() + body + "</div>";
      if (focusIdx != null) {
        card.querySelector<HTMLElement>('[data-lt-index="' + focusIdx + '"]')?.focus();
      }
    }

    function renderDetail(focusSel?: string) {
      const t = fan[detailIdx];
      if (!t) {
        renderShelf();
        return;
      }
      mode = "detail";
      const cover = t.coverImage
        ? '<img class="lt-detail-cover" src="' +
          esc(t.coverImage) +
          '" alt="' +
          esc("Album art for " + (t.album || t.title)) +
          '" width="220" height="220" />'
        : '<span class="lt-detail-cover lt-cover-blank"></span>';
      card.innerHTML =
        '<div class="lt-inner lt-fade">' +
        detailHeader(t) +
        '<div class="lt-detail">' +
        '<div class="lt-stage">' +
        '<div class="lt-vinyl" data-lt-vinyl aria-hidden="true"><div class="lt-vinyl-label"></div></div>' +
        cover +
        "</div>" +
        '<div class="lt-meta">' +
        '<p class="lt-artist">' +
        esc(t.artist) +
        "</p>" +
        '<p class="lt-track">' +
        esc(t.title) +
        "</p>" +
        '<p class="lt-time" data-lt-time hidden><span data-lt-cur>0:00</span><span class="lt-slash">/</span><span data-lt-dur>0:00</span></p>' +
        '<div class="lt-transport">' +
        '<button type="button" class="lt-tbtn" data-lt-action="prev" aria-label="Previous track">' +
        ICON_PREV +
        "</button>" +
        '<button type="button" class="lt-tbtn" data-lt-action="play" data-lt-play aria-label="' +
        playLabel(t) +
        '">' +
        ICON_PLAY +
        "</button>" +
        '<button type="button" class="lt-tbtn" data-lt-action="next" aria-label="Next track">' +
        ICON_NEXT +
        "</button>" +
        "</div></div></div></div>";
      syncAudioUI();
      if (focusSel) card.querySelector<HTMLElement>(focusSel)?.focus();
    }

    function syncAudioUI() {
      if (!card.isConnected) {
        audioWatchers.delete(syncAudioUI);
        return;
      }
      if (mode !== "detail") return;
      const t = fan[detailIdx];
      if (!t) return;
      const a = audio;
      const isThis = !!a && audioKey === trackKey(t);
      const playing = !!a && isThis && !a.paused && !a.ended;
      const started = !!a && isThis && (playing || a.currentTime > 0);

      card.querySelector("[data-lt-vinyl]")?.classList.toggle("lt-spin", playing);

      const playBtn = card.querySelector<HTMLElement>("[data-lt-play]");
      if (playBtn) {
        playBtn.innerHTML = playing ? ICON_PAUSE : ICON_PLAY;
        playBtn.setAttribute("aria-label", playing ? "Pause preview" : playLabel(t));
      }

      const pill = card.querySelector<HTMLElement>("[data-lt-time]");
      const cur = card.querySelector<HTMLElement>("[data-lt-cur]");
      const dur = card.querySelector<HTMLElement>("[data-lt-dur]");
      if (!pill || !cur || !dur) return;
      if (started && a) {
        pill.hidden = false;
        cur.textContent = fmt(a.currentTime);
        dur.textContent = fmt(a.duration);
      } else if (
        detailIdx === 0 &&
        data.current &&
        Number.isFinite(t.progressMs) &&
        Number.isFinite(t.durationMs)
      ) {
        // Snapshot of the live "now playing" progress from the API.
        pill.hidden = false;
        cur.textContent = fmt((t.progressMs ?? 0) / 1000);
        dur.textContent = fmt((t.durationMs ?? 0) / 1000);
      } else {
        pill.hidden = true;
      }
    }
    audioWatchers.add(syncAudioUI);

    function togglePlay() {
      const t = fan[detailIdx];
      if (!t) return;
      if (!t.previewUrl) {
        // No preview available — still functional: open the track on Spotify.
        if (t.songUrl) window.open(t.songUrl, "_blank", "noopener");
        return;
      }
      const a = ensureAudio();
      const k = trackKey(t);
      if (audioKey === k && !a.paused) {
        a.pause();
        return;
      }
      if (audioKey !== k) {
        stopAudio();
        a.src = t.previewUrl;
        audioKey = k;
      }
      a.play().catch(() => {
        /* autoplay restriction or decode failure — UI stays consistent */
      });
    }

    function step(dir: number) {
      if (!fan.length) return;
      if (audio && !audio.paused) audio.pause();
      detailIdx = (detailIdx + dir + fan.length) % fan.length;
      renderDetail('[data-lt-action="' + (dir > 0 ? "next" : "prev") + '"]');
    }

    async function load() {
      try {
        const res = await fetch(API_URL);
        if (!res.ok) throw new Error("HTTP " + res.status);
        const json = (await res.json()) as ListeningData;
        data = {
          isPlaying: !!json?.isPlaying,
          current: json?.current ?? null,
          recent: Array.isArray(json?.recent) ? json.recent : [],
        };
      } catch (err) {
        if (!warned) {
          warned = true;
          console.warn("Listening card unavailable:", err);
        }
        data = { isPlaying: false, current: null, recent: [] };
      }
      fan = (data.current ? [data.current, ...data.recent] : [...data.recent]).slice(0, MAX_FAN);
      renderShelf();
    }

    card.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      const el = target?.closest?.("[data-lt-action]") as HTMLElement | null;
      if (!el || !card.contains(el)) return;
      const action = el.dataset.ltAction;
      if (action === "refresh") load();
      else if (action === "open") {
        detailIdx = Number(el.dataset.ltIndex) || 0;
        renderDetail('[data-lt-action="back"]');
      } else if (action === "back") renderShelf(detailIdx);
      else if (action === "prev") step(-1);
      else if (action === "next") step(1);
      else if (action === "play") togglePlay();
    });

    const onKeydown = (e: KeyboardEvent) => {
      if (!card.isConnected) {
        document.removeEventListener("keydown", onKeydown);
        return;
      }
      if (e.key === "Escape" && mode === "detail") {
        e.preventDefault();
        renderShelf(detailIdx);
      }
    };
    document.addEventListener("keydown", onKeydown);

    load();
  }

  function initListeningCards() {
    document
      .querySelectorAll<HTMLElement>("[data-lt-card]:not([data-lt-bound])")
      .forEach((card) => {
        card.dataset.ltBound = "true";
        setupCard(card);
      });
  }

  initListeningCards();
  document.addEventListener("astro:after-swap", initListeningCards);
  document.addEventListener("astro:before-swap", () => stopAudio());
</script>

<style>
  .lt {
    width: 100%;
  }

  .lt-card {
    width: 100%;
    background: var(--tag-bg);
    border-radius: 24px;
    padding: 32px;
  }
  @media (max-width: 480px) {
    .lt-card {
      padding: 20px;
    }
  }

  /* Everything inside the card is (re)injected via innerHTML, so all inner
     selectors are :global under the scoped .lt-card parent. */

  .lt-card :global(.lt-fade) {
    animation: lt-fade-in 0.2s ease both;
  }
  @keyframes lt-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lt-card :global(.lt-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .lt-card :global(.lt-title) {
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--fg);
    margin: 0;
  }

  .lt-card :global(.lt-pill) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--hover-bg);
    border: 1px solid var(--border);
    color: var(--fg-secondary);
    padding: 10px 18px;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .lt-card :global(.lt-pill:hover) {
    color: var(--fg);
  }
  .lt-card :global(.lt-pill:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .lt-card :global(.lt-quiet) {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
    margin: 16px 0 0;
  }
  .lt-card :global(.lt-sub) {
    font-size: var(--text-sm);
    color: var(--fg-tertiary);
    margin: 18px 0 0;
  }

  /* ----- State 1: shelf / fan of covers ----- */

  .lt-card :global(.lt-fan) {
    display: flex;
    align-items: flex-end;
    padding: 24px 4px 56px;
  }
  .lt-card :global(.lt-cover) {
    position: relative;
    flex: 0 0 auto;
    width: 150px;
    height: 150px;
    padding: 0;
    border: 4px solid var(--thumb-border);
    border-radius: 12px;
    background: var(--tag-bg);
    box-shadow: 0 10px 24px color-mix(in oklab, var(--fg) 22%, transparent);
    cursor: pointer;
    z-index: var(--z, 1);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .lt-card :global(.lt-cover + .lt-cover) {
    margin-left: -100px;
  }
  .lt-card :global(.lt-cover.lt-active) {
    transform: translateY(-10px);
    z-index: 40;
    box-shadow: 0 18px 36px color-mix(in oklab, var(--fg) 35%, transparent);
  }
  .lt-card :global(.lt-cover:hover),
  .lt-card :global(.lt-cover:focus-visible) {
    transform: translateY(-6px);
    z-index: 50;
    box-shadow: 0 16px 32px color-mix(in oklab, var(--fg) 30%, transparent);
  }
  .lt-card :global(.lt-cover.lt-active:hover),
  .lt-card :global(.lt-cover.lt-active:focus-visible) {
    transform: translateY(-14px);
  }
  .lt-card :global(.lt-cover:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .lt-card :global(.lt-cover-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  .lt-card :global(.lt-cover-blank) {
    background: var(--hover-bg);
  }

  /* Subtle CSS reflection — mirrored background slice fading out downward.
     Without mask support it degrades to a faint mirrored strip. */
  .lt-card :global(.lt-cover)::after {
    content: "";
    position: absolute;
    left: -4px;
    right: -4px;
    top: calc(100% + 8px);
    height: 44px;
    border-radius: 12px;
    background-image: var(--cover);
    background-size: cover;
    background-position: bottom center;
    transform: scaleY(-1);
    opacity: 0.28;
    -webkit-mask-image: linear-gradient(to bottom, transparent 15%, black 95%);
    mask-image: linear-gradient(to bottom, transparent 15%, black 95%);
    pointer-events: none;
  }

  /* Floating tooltip chip above a hovered/focused cover */
  .lt-card :global(.lt-tip) {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, 4px);
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 20px color-mix(in oklab, var(--fg) 18%, transparent);
    padding: 10px 14px;
    pointer-events: none;
    opacity: 0;
    text-align: left;
    z-index: 5;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .lt-card :global(.lt-cover:hover .lt-tip),
  .lt-card :global(.lt-cover:focus-visible .lt-tip) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .lt-card :global(.lt-tip-artist),
  .lt-card :global(.lt-tip-title) {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.35;
  }
  .lt-card :global(.lt-tip-artist) {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .lt-card :global(.lt-tip-title) {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .lt-card :global(.lt-cover) {
      width: 96px;
      height: 96px;
    }
    .lt-card :global(.lt-cover + .lt-cover) {
      margin-left: -64px;
    }
    .lt-card :global(.lt-cover)::after {
      height: 28px;
    }
    .lt-card :global(.lt-fan) {
      padding-bottom: 40px;
    }
  }

  /* ----- State 2: detail with vinyl ----- */

  .lt-card :global(.lt-detail) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    align-items: center;
    margin-top: 28px;
  }

  .lt-card :global(.lt-stage) {
    position: relative;
    width: 320px;
    height: 228px;
  }
  .lt-card :global(.lt-detail-cover) {
    position: relative;
    display: block;
    width: 220px;
    height: 220px;
    object-fit: cover;
    border: 4px solid var(--thumb-border);
    border-radius: 12px;
    background: var(--tag-bg);
    box-shadow: 0 12px 28px color-mix(in oklab, var(--fg) 25%, transparent);
    z-index: 2;
  }

  /* Vinyl record peeking from behind the cover's right edge.
     Stays near-black in BOTH themes via a fixed dark mix. */
  .lt-card :global(.lt-vinyl) {
    position: absolute;
    top: 50%;
    left: 120px;
    width: 200px;
    height: 200px;
    margin-top: -100px;
    border-radius: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-radial-gradient(
      circle at center,
      color-mix(in oklab, black 88%, var(--bg)) 0 2.5px,
      color-mix(in oklab, black 74%, var(--bg)) 2.5px 3px,
      color-mix(in oklab, black 88%, var(--bg)) 3px 5px
    );
    box-shadow: 0 8px 20px color-mix(in oklab, var(--fg) 30%, transparent);
    animation: lt-spin 4s linear infinite;
    animation-play-state: paused;
  }
  .lt-card :global(.lt-vinyl.lt-spin) {
    animation-play-state: running;
  }
  @keyframes lt-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lt-card :global(.lt-vinyl-label) {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: conic-gradient(
      from 120deg,
      color-mix(in oklab, var(--fg) 35%, var(--bg)),
      color-mix(in oklab, var(--fg) 12%, var(--bg)) 35%,
      color-mix(in oklab, var(--fg) 28%, var(--bg)) 55%,
      color-mix(in oklab, var(--fg) 12%, var(--bg)) 80%,
      color-mix(in oklab, var(--fg) 35%, var(--bg))
