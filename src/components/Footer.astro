---
const year = new Date().getFullYear();
const socials = [
  { href: "https://x.com/designedbyalok", label: "Twitter" },
  { href: "https://www.linkedin.com/in/designedbyalok/", label: "LinkedIn" },
  { href: "https://peerlist.io/designedbyalok", label: "Peerlist" },
  { href: "https://dribbble.com/designedbyalok", label: "Dribbble" },
  { href: "https://github.com/designedbyalok", label: "GitHub" },
];
---

<footer class="site-footer container-edge">
  <div class="container-wide footer-grid">
    <div>
      <p class="display footer-sig">Alok Kumar</p>
      <p class="footer-place">Pune, Maharashtra · India</p>
    </div>

    <nav aria-label="Social" class="footer-socials">
      <ul>
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="link link-accent"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-contact">
      <a href="mailto:designedbyalok@gmail.com" class="link link-accent">
        designedbyalok@gmail.com
      </a>
      <p class="footer-copy">© {year} — Built with care.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 8rem;
    padding-block: 3rem 2rem;
    border-top: 1px solid var(--rule);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  .footer-sig {
    font-size: var(--text-3xl);
    margin: 0;
  }
  .footer-place {
    margin-top: 0.25rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .footer-socials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }
  .footer-contact {
    text-align: right;
    font-size: var(--text-sm);
  }
  .footer-copy {
    margin-top: 0.5rem;
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }
  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .footer-contact { text-align: left; }
  }
</style>
