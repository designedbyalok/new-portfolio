---
const path = Astro.url.pathname;
const isActive = (p: string) =>
  p === "/" ? path === "/" : path.startsWith(p);

const links = [
  { href: "/work", label: "Work" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];
---

<header class="site-header container-edge">
  <div class="container-wide header-row">
    <a href="/" class="brand" aria-label="Alok - Designer — home">
      <img src="/favicon.svg" alt="Alok Logo" width="24" height="24" class="brand-logo" style="border-radius: 4px;" />
      <span class="brand-name">Alok - Designer</span>
    </a>

    <nav aria-label="Primary" class="primary-nav">
      <ul class="nav-list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={["nav-link", isActive(l.href) && "is-active"]}
                aria-current={isActive(l.href) ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="theme-toggle"
      aria-label="Toggle color theme"
      data-theme-toggle
    >
      <svg
        class="theme-icon icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m4.93 19.07 1.41-1.41"></path>
        <path d="m17.66 6.34 1.41-1.41"></path>
      </svg>
      <svg
        class="theme-icon icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  function applyToggleListener() {
    const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (!btn || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const current = root.getAttribute("data-theme");
      const systemDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      let next: "light" | "dark";
      if (current === "dark") next = "light";
      else if (current === "light") next = "dark";
      else next = systemDark ? "light" : "dark";

      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }

  applyToggleListener();
  document.addEventListener("astro:after-swap", applyToggleListener);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 90%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 60%, transparent);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    transition: transform 0.2s ease;
  }
  .brand:hover .brand-logo {
    transform: scale(1.05);
  }
  .primary-nav {
    margin-left: auto;
    margin-right: 0.75rem;
  }
  .nav-list {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    padding-block: 0.2rem;
    position: relative;
    transition: color 180ms ease;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link.is-active { color: var(--ink); }
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--accent);
  }

  .theme-toggle {
    appearance: none;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-muted);
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    position: relative;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .theme-icon {
    position: absolute;
    width: 1.05rem;
    height: 1.05rem;
    transition: opacity 280ms ease, transform 380ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* Default (light) → show moon (offer to switch to dark) */
  .icon-sun { opacity: 0; transform: rotate(-30deg) scale(0.85); }
  .icon-moon { opacity: 1; transform: rotate(0) scale(1); }

  /* Forced dark → show sun */
  :root[data-theme="dark"] .icon-sun { opacity: 1; transform: rotate(0) scale(1); }
  :root[data-theme="dark"] .icon-moon { opacity: 0; transform: rotate(30deg) scale(0.85); }

  /* System dark, not overridden by light → show sun */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .icon-sun {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
    :root:not([data-theme="light"]) .icon-moon {
      opacity: 0;
      transform: rotate(30deg) scale(0.85);
    }
  }

  @media (max-width: 640px) {
    .brand-name { display: none; }
    .nav-list { gap: 1.1rem; }
    .primary-nav { margin-right: 0.4rem; }
    .header-row { gap: 0.5rem; }
  }
</style>
